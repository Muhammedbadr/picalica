<%# app/views/carts/_cart.html.erb %>
<%= turbo_frame_tag "cart" do %>
  <div class="mx-auto max-w-7xl mt-8 p-4 md:p-8">

    <%# ── Header ── %>
    <div class="flex items-center gap-4 mb-8">
      <div class="w-12 h-12 rounded-2xl bg-[#5D5899]/10 flex items-center justify-center text-[#5D5899]">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z"/>
        </svg>
      </div>
      <div>
        <h1 class="text-2xl font-black text-gray-900 tracking-tight">Your Cart</h1>
        <% if @cart.cart_items.any? %>
          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mt-0.5">
            <%= pluralize(@cart.cart_items.count, "item") %>
          </p>
        <% end %>
      </div>
    </div>

    <% if @cart.cart_items.any? %>

      <%# ── Two-column layout: items left, summary right ── %>
      <div class="flex flex-col lg:flex-row gap-8 items-start">

        <%# ── LEFT: Scrollable Items List ── %>
        <div class="flex-1 min-w-0">
          <div class="space-y-3 max-h-[70vh] overflow-y-auto pr-1">
            <%= render "carts/cart_items" %>
          </div>
        </div>

        <%# ── RIGHT: Sticky Order Summary ── %>
        <div class="w-full lg:w-100 shrink-0 lg:sticky lg:top-8 space-y-4">

          <%# Summary Card %>
          <div class="bg-white rounded-[1.5rem] border border-gray-100 shadow-sm p-6 space-y-5">
            <span class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Order Summary</span>

            <div class="space-y-3">
              <div class="flex justify-between items-center">
                <span class="text-sm font-semibold text-gray-500">Subtotal</span>
                <span class="text-sm font-black text-gray-700">
                  <%= number_to_currency(@cart.total) %>
                </span>
              </div>

              <div class="flex justify-between items-center">
                <span class="text-sm font-semibold text-gray-500">Items</span>
                <span class="text-sm font-black text-gray-700">
                  <%= @cart.cart_items.count %>
                </span>
              </div>

              <div class="flex justify-between items-center">
                <span class="text-sm font-semibold text-gray-500">Tax</span>
                <span class="text-[11px] font-black text-[#79C343] uppercase tracking-wider">Free</span>
              </div>
            </div>

            <div class="border-t border-gray-100 pt-4 flex justify-between items-center">
              <span class="text-xs font-black text-gray-900 uppercase tracking-widest">Total</span>
              <span class="text-2xl font-black text-[#5D5899]">
                <%= number_to_currency(@cart.total) %>
              </span>
            </div>
          </div>

          <%# Checkout Button %>
          <%= link_to "#",
                data: { turbo_frame: "_top" },
                class: "block w-full text-center px-8 py-4 bg-[#79C343] text-white rounded-[1.25rem]
                        font-black text-xs uppercase tracking-[0.2em] shadow-lg shadow-green-100
                        hover:bg-[#6ab038] hover:scale-[1.02] active:scale-95 transition-all" do %>
            Proceed to Checkout →
          <% end %>

          <%# Continue Shopping %>
          <div class="text-center pt-1">
            <%= link_to "← Continue Shopping", root_path,
                  data: { turbo_frame: "_top" },
                  class: "text-[10px] font-black text-gray-400 hover:text-[#5D5899] uppercase tracking-widest transition-colors" %>
          </div>

        </div>
      </div>

    <% else %>

      <%# ── Empty State ── %>
      <div class="bg-white rounded-[2rem] border border-gray-100 shadow-sm p-16 flex flex-col items-center gap-6 text-center">
        <div class="w-20 h-20 rounded-[1.5rem] bg-gray-50 border-2 border-dashed border-gray-200 flex items-center justify-center">
          <svg class="w-9 h-9 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z"/>
          </svg>
        </div>
        <div class="space-y-2">
          <h2 class="text-xl font-black text-gray-900">Your cart is empty</h2>
          <p class="text-sm text-gray-400 font-semibold max-w-xs mx-auto leading-relaxed">
            Looks like you haven't added anything yet. Explore our products!
          </p>
        </div>
        <%= link_to "Browse Products", products_path,
              data: { turbo_frame: "_top" },
              class: "inline-block px-10 py-4 bg-[#5D5899] text-white rounded-[1rem]
                      font-black text-xs uppercase tracking-[0.2em]
                      hover:bg-[#4e4a85] hover:scale-105 active:scale-95 transition-all shadow-lg shadow-purple-100" %>
      </div>

    <% end %>
  </div>
<% end %>
