<%# app/views/payments/pay.html.erb %>

<div class="min-h-screen bg-gray-50/60 py-8 px-3 sm:px-6">
  
  
  <div class="max-w-6xl mx-auto mt-4 sm:mt-8">
    <div class="mb-6">
      <nav class="flex items-center space-x-3 text-[11px] font-black uppercase tracking-[0.15em] text-gray-400 mb-4">
        
        <a href="/" 
          data-turbo-frame="_top"
          class="hover:text-[#5D5899] transition-all flex items-center group">
          
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1.5 opacity-60 group-hover:opacity-100" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          
          Home
        </a>

        <span class="text-gray-600 font-light">/</span>

        <a href="<%= cart_path %>" 
          data-turbo-frame="_top"
          class=" opacity-90 transition-all">
          Cart
        </a>
        <span class="text-gray-600 font-light">/</span>

        <a href="" 
          data-turbo-frame="_top"
          class="text-[#5D5899] opacity-90 transition-all">
          Pay
        </a>

      </nav>
    </div>
    <%# ── Header ── %>
    <div class="flex items-center gap-3 mb-8">
      <div class="w-11 h-11 rounded-2xl bg-[#5D5899]/10 flex items-center justify-center text-[#5D5899]">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z"/>
        </svg>
      </div>
      <div>
        <h1 class="text-xl sm:text-2xl font-black text-gray-900 tracking-tight">Checkout</h1>
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mt-0.5">Secure Payment</p>
      </div>
    </div>

    <div class="flex flex-col lg:flex-row gap-6 items-start">

      <%# ══════════════════════════════════════════ %>
      <%# LEFT — Payment Form                        %>
      <%# ══════════════════════════════════════════ %>
      <div class="w-full flex-1 space-y-5">

        <%# ── Contact Info ── %>
        <div class="bg-white rounded-[1.5rem] border border-gray-100 shadow-sm p-6 space-y-5">
          <div class="flex items-center gap-3 pb-2 border-b border-gray-50">
            <div class="w-7 h-7 rounded-xl bg-[#5D5899]/10 flex items-center justify-center text-[#5D5899]">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
              </svg>
            </div>
            <span class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Contact Information</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1.5">
              <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Full Name</label>
              <input type="text"
                     value="<%= current_user.name.presence || current_user.username %>"
                     readonly
                     class="w-full bg-gray-50 border border-gray-100 rounded-2xl px-4 py-3 text-sm font-semibold text-gray-700 outline-none cursor-default">
            </div>
            <div class="space-y-1.5">
              <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Email Address</label>
              <input type="email"
                     value="<%= current_user.email %>"
                     readonly
                     class="w-full bg-gray-50 border border-gray-100 rounded-2xl px-4 py-3 text-sm font-semibold text-gray-700 outline-none cursor-default">
            </div>
          </div>
        </div>

        <%# ── Payment Card ── %>
        <div class="bg-white rounded-[1.5rem] border border-gray-100 shadow-sm p-6 space-y-5">
          <div class="flex items-center justify-between pb-2 border-b border-gray-50">
            <div class="flex items-center gap-3">
              <div class="w-7 h-7 rounded-xl bg-[#5D5899]/10 flex items-center justify-center text-[#5D5899]">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z"/>
                </svg>
              </div>
              <span class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Payment Details</span>
            </div>
            <%# Card brand icons %>
            <div class="flex items-center gap-2">
              <div class="h-6 px-2 bg-gray-50 border border-gray-100 rounded-lg flex items-center justify-center">
                <span class="text-[9px] font-black text-blue-600 uppercase tracking-wider">VISA</span>
              </div>
              <div class="h-6 px-2 bg-gray-50 border border-gray-100 rounded-lg flex items-center justify-center">
                <span class="text-[9px] font-black text-red-500 uppercase tracking-wider">MC</span>
              </div>
              <div class="h-6 px-2 bg-gray-50 border border-gray-100 rounded-lg flex items-center justify-center">
                <span class="text-[9px] font-black text-blue-800 uppercase tracking-wider">AMEX</span>
              </div>
            </div>
          </div>

          <%# Stripe card element mounts here %>
        <%= form_with url: charge_cart_path, method: :post, id: "payment-form", class: "space-y-4" do |f| %>            <%# Card Number %>
            <div class="space-y-1.5">
              <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Card Number</label>
              <div id="card-number-element"
                   class="w-full bg-gray-50 border border-gray-100 rounded-2xl px-4 py-3.5 text-sm min-h-[46px]">
              </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
              <%# Expiry %>
              <div class="space-y-1.5">
                <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Expiry Date</label>
                <div id="card-expiry-element"
                     class="w-full bg-gray-50 border border-gray-100 rounded-2xl px-4 py-3.5 text-sm min-h-[46px]">
                </div>
              </div>
              <%# CVC %>
              <div class="space-y-1.5">
                <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Security Code</label>
                <div id="card-cvc-element"
                     class="w-full bg-gray-50 border border-gray-100 rounded-2xl px-4 py-3.5 text-sm min-h-[46px]">
                </div>
              </div>
            </div>

            <%# Stripe hidden token field %>
            <%= f.hidden_field :stripeToken, id: "stripe-token" %>

            <%# Error message area %>
            <div id="card-errors"
                 class="hidden text-[11px] font-semibold text-red-500 bg-red-50 rounded-xl px-4 py-3">
            </div>

            <%# SSL badge %>
            <div class="flex items-center gap-2 pt-1">
              <svg class="w-3.5 h-3.5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/>
              </svg>
              <span class="text-[9px] font-bold text-gray-300 uppercase tracking-widest">
                256-bit SSL Encrypted — Powered by Stripe
              </span>
            </div>

          <% end %>
        </div>

      </div>

      <%# ══════════════════════════════════════════ %>
      <%# RIGHT — Order Summary Sidebar              %>
      <%# ══════════════════════════════════════════ %>
      <div class="w-full lg:w-80 xl:w-96 shrink-0 lg:sticky lg:top-8 space-y-4">

        <%# Items Summary %>
        <div class="bg-white rounded-[1.5rem] border border-gray-100 shadow-sm p-6 space-y-5">
          <span class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Order Summary</span>

          <%# Item list %>
          <div class="space-y-4 max-h-64 overflow-y-auto pr-1">
            <% @cart.cart_items.each do |item| %>
              <% product = item.product %>
              <% img = product.images.first %>

              <div class="flex items-center gap-3">
                <%# Thumbnail %>
                <div class="w-12 h-12 shrink-0 rounded-xl overflow-hidden bg-gray-50 border border-gray-100">
                  <% if img&.image&.attached? %>
                    <%= image_tag img.image, class: "w-full h-full object-cover", loading: "lazy" %>
                  <% else %>
                    <div class="w-full h-full flex items-center justify-center text-gray-200">
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                        <rect x="3" y="3" width="18" height="18" rx="2"/>
                        <circle cx="8.5" cy="8.5" r="1.5"/>
                        <path d="M21 15l-5-5L5 21"/>
                      </svg>
                    </div>
                  <% end %>
                </div>

                <%# Info %>
                <div class="flex-1 min-w-0">
                  <p class="text-[12px] font-black text-gray-900 truncate"><%= product.title %></p>
                  <% selected_license = item.respond_to?(:license) ? item.license : product.licenses.first %>
                  <p class="text-[10px] font-semibold text-gray-400 truncate">
                    <%= selected_license&.title_name %>
                  </p>
                </div>

                <%# Price %>
                <span class="text-[12px] font-black text-[#5D5899] shrink-0">
                  <%= number_to_currency(selected_license&.price.to_f) %>
                </span>
              </div>
            <% end %>
          </div>

          <%# Divider %>
          <div class="border-t border-gray-100 space-y-3 pt-4">
            <div class="flex justify-between items-center">
              <span class="text-sm font-semibold text-gray-500">Subtotal</span>
              <span class="text-sm font-black text-gray-700"><%= number_to_currency(@cart.total) %></span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-sm font-semibold text-gray-500">Tax</span>
              <span class="text-[11px] font-black text-[#79C343] uppercase">Free</span>
            </div>
            <div class="flex justify-between items-center pt-2 border-t border-gray-100">
              <span class="text-xs font-black text-gray-900 uppercase tracking-widest">Total</span>
              <span class="text-2xl font-black text-[#5D5899]"><%= number_to_currency(@cart.total) %></span>
            </div>
          </div>
        </div>

        <%# Pay Button — submits the Stripe form %>
        <button type="submit"
                form="payment-form"
                id="pay-button"
                class="w-full px-8 py-4 bg-[#79C343] text-white rounded-[1.25rem]
                       font-black text-xs uppercase tracking-[0.2em] shadow-lg shadow-green-100
                       hover:bg-[#6ab038] hover:scale-[1.02] active:scale-95 transition-all cursor-pointer">
          Pay <%= number_to_currency(@cart.total) %> Now →
        </button>

        <%# Back to cart %>
        <div class="text-center">
          <%= link_to "← Back to Cart", cart_path,
                class: "text-[10px] font-black text-gray-400 hover:text-[#5D5899] uppercase tracking-widest transition-colors" %>
        </div>

        <%# Trust badges %>
        <div class="bg-white rounded-[1.5rem] border border-gray-100 p-4 grid grid-cols-3 gap-3 text-center">
          <div class="space-y-1.5">
            <div class="w-8 h-8 rounded-xl bg-green-50 flex items-center justify-center text-[#79C343] mx-auto">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/>
              </svg>
            </div>
            <p class="text-[8px] font-black text-gray-400 uppercase tracking-wider leading-tight">Secure Payment</p>
          </div>
          <div class="space-y-1.5">
            <div class="w-8 h-8 rounded-xl bg-blue-50 flex items-center justify-center text-blue-500 mx-auto">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/>
              </svg>
            </div>
            <p class="text-[8px] font-black text-gray-400 uppercase tracking-wider leading-tight">Instant Download</p>
          </div>
          <div class="space-y-1.5">
            <div class="w-8 h-8 rounded-xl bg-purple-50 flex items-center justify-center text-[#5D5899] mx-auto">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12c0-1.232-.046-2.453-.138-3.662a4.006 4.006 0 00-3.7-3.7 48.678 48.678 0 00-7.324 0 4.006 4.006 0 00-3.7 3.7c-.017.22-.032.441-.046.662M19.5 12l3-3m-3 3l-3-3m-12 3c0 1.232.046 2.453.138 3.662a4.006 4.006 0 003.7 3.7 48.656 48.656 0 007.324 0 4.006 4.006 0 003.7-3.7c.017-.22.032-.441.046-.662M4.5 12l3 3m-3-3l-3 3"/>
              </svg>
            </div>
            <p class="text-[8px] font-black text-gray-400 uppercase tracking-wider leading-tight">Easy Refund</p>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<%# ── Stripe JS ── %>
<script src="https://js.stripe.com/v3/"></script>
<script>
  const stripe = Stripe('<%= ENV["STRIPE_PUBLISHABLE_KEY"] %>');
  const elements = stripe.elements();

  const style = {
    base: {
      fontSize: '14px',
      fontWeight: '600',
      color: '#111827',
      fontFamily: 'inherit',
      '::placeholder': { color: '#d1d5db' }
    },
    invalid: { color: '#ef4444' }
  };

  const cardNumber  = elements.create('cardNumber',  { style });
  const cardExpiry  = elements.create('cardExpiry',  { style });
  const cardCvc     = elements.create('cardCvc',     { style });

  cardNumber.mount('#card-number-element');
  cardExpiry.mount('#card-expiry-element');
  cardCvc.mount('#card-cvc-element');

  // Show live validation errors
  [cardNumber, cardExpiry, cardCvc].forEach(el => {
    el.on('change', ({ error }) => {
      const display = document.getElementById('card-errors');
      if (error) {
        display.textContent = error.message;
        display.classList.remove('hidden');
      } else {
        display.textContent = '';
        display.classList.add('hidden');
      }
    });
  });

  // On submit: tokenize card → inject token → submit form
  const form    = document.getElementById('payment-form');
  const payBtn  = document.getElementById('pay-button');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    payBtn.disabled = true;
    payBtn.textContent = 'Processing...';

    const { token, error } = await stripe.createToken(cardNumber);

    if (error) {
      const display = document.getElementById('card-errors');
      display.textContent = error.message;
      display.classList.remove('hidden');
      payBtn.disabled = false;
      payBtn.textContent = 'Pay Now →';
    } else {
      document.getElementById('stripe-token').value = token.id;
      form.submit();
    }
  });
</script>
