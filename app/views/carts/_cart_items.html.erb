<% @cart.cart_items.each do |item| %>
  <% product = item.product %>
  <% img = product.images.first %>

  <div id="cart-item-<%= product.id %>"
       class="group flex gap-5 p-5 bg-white rounded-[1.5rem] border border-gray-100 shadow-sm hover:shadow-md transition-all duration-300">

    <%# ── Product Thumbnail ── %>
    <div class="relative w-24 h-24 shrink-0 rounded-2xl overflow-hidden bg-gray-50 border border-gray-100">
      <% if img&.image&.attached? %>
        <% img.image.analyze unless img.image.analyzed? %>
        <%= image_tag img.image,
              class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-500",
              loading: "lazy" %>
      <% else %>
        <div class="w-full h-full flex items-center justify-center text-gray-300">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <rect x="3" y="3" width="18" height="18" rx="2"/>
            <circle cx="8.5" cy="8.5" r="1.5"/>
            <path d="M21 15l-5-5L5 21"/>
          </svg>
        </div>
      <% end %>
    </div>

    <%# ── Product Info ── %>
    <div class="flex-1 min-w-0 space-y-2">

      <div class="flex items-start justify-between gap-3">
        <h3 class="text-[15px] font-black text-gray-900 leading-snug truncate">
          <%= product.title %>
        </h3>

        <%# Remove button %>
        <%= button_to cart_item_path(item),
              method: :delete,
              data: { turbo_confirm: "Remove this item from cart?" },
              class: "shrink-0 w-8 h-8 rounded-xl flex items-center justify-center text-gray-300 hover:text-red-500 hover:bg-red-50 transition-all cursor-pointer border-0 bg-transparent" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        <% end %>
      </div>

      <%# Seller %>
      <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">
        by <%= product.user.name %>
      </p>

      <%# Licenses %>
      <div class="flex flex-wrap gap-2 pt-1">
        <% product.licenses.each do |license| %>
          <div class="inline-flex items-center gap-2 bg-[#5D5899]/8 border border-[#5D5899]/15 rounded-xl px-3 py-1.5">
            <span class="text-[10px] font-black text-[#5D5899] uppercase tracking-wider">
              <%= license.title_name %>
            </span>
            <span class="w-px h-3 bg-[#5D5899]/20"></span>
            <span class="text-[11px] font-black text-[#5D5899]">
              <%= number_to_currency(license.price) %>
            </span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
