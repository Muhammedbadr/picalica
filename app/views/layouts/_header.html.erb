    <div class="flex justify-between h-16 items-center">
      
      <%# RIGHT SIDE: Branding %>
      <div class="flex items-center gap-10">
        
        <a href="/" class="flex items-center space-x-2 group">
          <div class="bg-white text-[#5D5899] p-1.5 rounded-lg">
            <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
          </div>
          <span class="text-xl font-black tracking-tighter uppercase">Picalica</span>
        </a>
        <%# Nav Links with custom hover under-line effect %>
        <div class="hidden lg:flex items-center gap-8">
          <% if user_signed_in? %>
            <%= link_to "Upload Product +",  new_product_path, class: "text-sm font-bold bg-white/10 px-3 py-1.5 rounded-lg hover:bg-white/20 transition-all" %>
            <%= link_to "My Products", products_path, class: "text-sm font-semibold opacity-80 hover:opacity-100 transition-opacity" %>
          <% end %>
          <%= link_to "Categories", "#", class: "text-sm font-semibold opacity-80 hover:opacity-100 transition-opacity" %>
        </div>
      </div>

      <%# LEFT SIDE: Search, Cart, & Profile %>
      <div class="flex items-center gap-2 sm:gap-5">
      
        <%# Profile & Auth %>
        <div class="flex items-center gap-2 sm:gap-4 pl-4 ">
          <% if user_signed_in? %>
            <%# <button class="w-10 h-10 hidden sm:flex items-center justify-center hover:bg-white/10 rounded-full transition-all relative">
              <i class="fa-solid fa-bell text-lg"></i>
              <span class="absolute top-2.5 right-2.5 flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
              </span>
            </button> %>

            <%# Integrated Profile Link %>
            <div class="flex items-center gap-3">
            <%= link_to "Log out", destroy_user_session_path, 
                data: { turbo_method: :delete }, 
                class: "hidden md:block text-[10px] font-black uppercase tracking-widest bg-white/10 hover:bg-white/20 px-3 py-1.5 rounded-lg border border-white/10 transition-all" %>               
               <%= link_to edit_user_registration_path, class: "p-0.5 rounded-full border-2 border-transparent hover:border-white/30 transition-all" do %>
                 <div class="w-9 h-9 rounded-full bg-gradient-to-tr from-indigo-400 to-purple-400 flex items-center justify-center text-white font-bold shadow-md">
                   <%= current_user.email[0].upcase %>
                 </div>
               <% end %>
            </div>
          <% else %>
            <div class="flex items-center gap-4">
              <%= link_to "Login", new_user_session_path, class: "text-sm font-bold hover:text-white/80 transition-colors" %>
