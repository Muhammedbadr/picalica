<nav class="fixed top-0 z-50 w-full bg-[#5D5899] backdrop-blur-sm text-white shadow-sm">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-8">
    <div class="flex justify-between h-16 items-center">
      
      <%# RIGHT SIDE: Branding %>
      <div class="flex items-center gap-10">
        
        <a href="/" class="flex items-center space-x-2 group">
          <div class="bg-white text-[#5D5899] p-1.5 rounded-lg">
            <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
          </div>
          <span class="text-xl font-black tracking-tighter uppercase">Picalica</span>
        </a>
        <%# Nav Links with custom hover under-line effect %>
        <div class="hidden lg:flex items-center gap-8">
          <% if user_signed_in? %>
            <%= link_to "Upload Product +",  new_product_path, class: "text-sm font-bold bg-white/10 px-3 py-1.5 rounded-lg hover:bg-white/20 transition-all" %>
            <%= link_to "My Products",  my_product_products_path, class: "text-sm font-semibold opacity-80 hover:opacity-100 transition-opacity" %>
          <% end %>
            <%# Categories Mega Dropdown %>
          <div class="relative" id="categoriesWrapper">
            <button type="button"
              onclick="document.getElementById('categoriesWrapper').classList.toggle('open')"
              class="cat-trigger cursor-pointer  flex items-center gap-1.5 text-sm font-semibold opacity-80 hover:opacity-100 transition-opacity">
                Categories
              <svg class="w-3 h-3 transition-transform duration-200 cat-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
                <style>
                  #categoriesWrapper.open #catArrow {
                    display: block;
                  }
                </style>
              <%# Arrow sits below the button, centered on it %>
            <div id="catArrow" class="hidden absolute -bottom-[29px] left-1/2 -translate-x-1/2 w-4 h-4 bg-white rotate-45 border-l border-t border-gray-100 z-[51]"></div>

            <%# Mega dropdown panel %>
            <div id="categoriesMenu"
                class="hidden fixed left-0 top-[64px] w-screen bg-white shadow-2xl shadow-black/10 border-y border-gray-100 z-50">
              <%# Arrow pointer %>
              <%# Triangle pointer under the Categories button %>

              <style>
                #categoriesWrapper.open #categoriesMenu { display: block !important; }
                #categoriesWrapper.open .cat-chevron { transform: rotate(180deg); }
              </style>

              <div class="grid grid-cols-4 divide-x divide-gray-100">

                <% (@nav_categories || []).each do |category| %>
                  <div class="p-5">
                    <p class="text-[10px] font-black uppercase tracking-widest text-[#5D5899] mb-3 pb-2.5 border-b-2 border-[#eeecf9]">
                      <%= category.name %>
                    </p>
                    <% category.subcategories.each do |sub| %>
                      <%= link_to sub.name, products_path(subcategory: sub.name),
                          class: "mega-item flex items-center gap-2 py-1.5 text-[13px] font-medium text-gray-600 hover:text-[#5D5899] transition-colors" %>
                    <% end %>
                  </div>
                <% end %>

              </div>
            </div>
          </div>
        </div>
      </div>

      <%# LEFT SIDE: Search, Cart, & Profile %>
      <div class="flex items-center gap-2 sm:gap-5">
        <%# <%CART %>
        
        <%# Profile & Auth %>
        <div class="flex items-center gap-4 sm:gap-4 pl-4 ">
          <% if user_signed_in? %>
            <div>
              <%= link_to cart_path, class: "text-sm font-semibold opacity-80 hover:opacity-100 transition-opacity" do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
                </svg>
              <% end %>
            </div>
            <%# ── USER AVATAR + DROPDOWN ── %>
            <div class="relative dropdown-wrapper" id="profileDropdown">

              <%# Avatar button — toggles dropdown %>
              <button type="button"
                      onclick="document.getElementById('profileDropdown').classList.toggle('open')"
                      class="cursor-pointer flex items-center gap-2.5 p-1 rounded-full border-2 border-transparent hover:border-white/30 focus:outline-none transition-all group">

                <div class="w-9 h-9 rounded-full overflow-hidden bg-gradient-to-tr from-indigo-400 to-purple-400 flex items-center justify-center text-white font-bold shadow-md ring-2 ring-white/20 group-hover:ring-white/40 transition-all">
