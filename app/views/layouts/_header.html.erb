                    <%= image_tag current_user.avatar, width: 36, height: 36, class: "w-full h-full object-cover" %>
                  <% else %>
                    <span class="text-sm font-black"><%= current_user.email[0].upcase %></span>
                  <% end %>
                </div>

                <%# Chevron icon %>
                <svg data-dropdown-target="chevron" class="w-3.5 h-3.5 text-white/70 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                </svg>
              </button>

              <%# ── DROPDOWN PANEL ── %>
              <div id="profileMenu"
                  class="hidden absolute right-0 top-full mt-3 w-56 z-50 transition-all duration-200">
                
                <style>
                  #profileDropdown.open #profileMenu {
                    display: block !important;
                  }
                </style>
                <div class="absolute -top-1.5 right-4 w-3 h-3 bg-white rotate-45 rounded-sm shadow-sm border-l border-t border-gray-100/80"></div>

                <div class="bg-white rounded-[1.25rem] shadow-2xl shadow-black/10 border border-gray-100 overflow-hidden">

                  <%# User identity header %>
                  <div class="px-5 py-4 bg-gradient-to-br from-[#5D5899]/8 to-[#5D5899]/3 border-b border-gray-100">
                    <div class="flex items-center gap-3">
                      <div class="w-10 h-10 rounded-full overflow-hidden bg-gradient-to-tr from-indigo-400 to-purple-400 flex items-center justify-center text-white font-bold shadow-sm flex-shrink-0">
                        <% if current_user.avatar.attached? %>
                          <%= image_tag current_user.avatar, class: "w-full h-full object-cover" %>
                        <% else %>
                          <span class="text-sm font-black"><%= current_user.email[0].upcase %></span>
                        <% end %>
                      </div>
                      <div class="min-w-0">
                        <p class="text-[13px] font-black text-gray-900 truncate"><%= current_user.username %></p>
                        <p class="text-[11px] text-gray-400 font-medium truncate"><%= current_user.email %></p>
                      </div>
                    </div>
                  </div>

                  <%# Menu items %>
                  <div class="py-2">

                    <%# Replace "#" below with your actual route helpers when you create them %>
                    <%= link_to user_path(current_user),
                        class: "flex items-center gap-3 px-4 py-2.5 text-sm font-semibold text-gray-700 hover:bg-[#5D5899]/5 hover:text-[#5D5899] transition-all group mx-1 rounded-xl" do %>
                      <span class="w-7 h-7 rounded-lg bg-gray-100 group-hover:bg-[#5D5899]/10 flex items-center justify-center transition-colors">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                        </svg>

                      </span>
                      Profile
                    <% end %>

                    <%= link_to cart_path,
                        class: "flex items-center gap-3 px-4 py-2.5 text-sm font-semibold text-gray-700 hover:bg-[#5D5899]/5 hover:text-[#5D5899] transition-all group mx-1 rounded-xl" do %>
                      <span class="w-7 h-7 rounded-lg bg-gray-100 group-hover:bg-[#5D5899]/10 flex items-center justify-center transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3.5 h-3.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
                        </svg>
                      </span>
                      
                      Shopping Carts
                    <% end %>

                    <%= link_to "#",
                        class: "flex items-center gap-3 px-4 py-2.5 text-sm font-semibold text-gray-700 hover:bg-[#5D5899]/5 hover:text-[#5D5899] transition-all group mx-1 rounded-xl" do %>
                      <span class="w-7 h-7 rounded-lg bg-gray-100 group-hover:bg-[#5D5899]/10 flex items-center justify-center transition-colors">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"/>
                        </svg>
                      </span>
                      Coupons
                    <% end %>

                    <%= link_to edit_user_registration_path,
                        class: "flex items-center gap-3 px-4 py-2.5 text-sm font-semibold text-gray-700 hover:bg-[#5D5899]/5 hover:text-[#5D5899] transition-all group mx-1 rounded-xl" do %>
                      <span class="w-7 h-7 rounded-lg bg-gray-100 group-hover:bg-[#5D5899]/10 flex items-center justify-center transition-colors">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><circle cx="12" cy="12" r="3"/>
                        </svg>
                      </span>
                      Settings
                    <% end %>

                    <%= link_to "#",
                        class: "flex items-center gap-3 px-4 py-2.5 text-sm font-semibold text-gray-700 hover:bg-[#5D5899]/5 hover:text-[#5D5899] transition-all group mx-1 rounded-xl" do %>
                      <span class="w-7 h-7 rounded-lg bg-gray-100 group-hover:bg-[#5D5899]/10 flex items-center justify-center transition-colors">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                      </span>
                      Help
                    <% end %>

                  </div>

                  <%# Logout — separated with border %>
                  <div class="border-t border-gray-100 p-2">
                    <%= link_to destroy_user_session_path,
                        data: { turbo_method: :delete },
                        class: "flex items-center gap-3 px-4 py-2.5 text-sm font-semibold text-red-500 hover:bg-red-50 transition-all group rounded-xl" do %>
                      <span class="w-7 h-7 rounded-lg bg-red-50 group-hover:bg-red-100 flex items-center justify-center transition-colors">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                        </svg>
                      </span>
                      Log out
                    <% end %>
                  </div>

                </div>
              </div>
            </div>
          <% else %>
            <%# ── GUEST BUTTONS ── %>
            <div class="flex items-center gap-4">
              <%= link_to "Login", new_user_session_path,
                  class: "text-sm font-bold hover:text-white/80 transition-colors" %>
              <%= link_to "Join Picalica", new_user_registration_path,
                  class: "px-6 py-2 bg-white text-[#5D5899] hover:bg-indigo-50 text-sm font-black rounded-full shadow-lg transition-all active:scale-95" %>
            </div>
          <% end %>


          <%# Mobile Menu
          <button class="lg:hidden w-10 h-10 flex items-center justify-center bg-white/10 rounded-lg">
            <i class="fa-solid fa-bars-staggered text-xl"></i>
          </button> %>
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  // Close dropdown when clicking outside
  document.addEventListener('click', function(event) {
    const dropdown = document.getElementById('profileDropdown');
    const isClickInsideDropdown = dropdown && dropdown.contains(event.target);
    
    if (!isClickInsideDropdown && dropdown && dropdown.classList.contains('open')) {
      dropdown.classList.remove('open');
    }
  });
  document.addEventListener('click', function(event) {
  // existing profileDropdown code...

    const categoriesWrapper = document.getElementById('categoriesWrapper');
    if (categoriesWrapper && !categoriesWrapper.contains(event.target)) {
      categoriesWrapper.classList.remove('open');
    }
  });
  function toggleCatMenu() {
    const menu = document.getElementById('categoriesMenu');
    const arrow = document.getElementById('catArrow');
    const btn = document.getElementById('catBtn');
    
    const isOpen = menu.classList.toggle('hidden') === false;
    
    if (isOpen) {
      // Position arrow under the center of the Categories button
      const btnRect = btn.getBoundingClientRect();
      const btnCenter = btnRect.left + btnRect.width / 2;
      arrow.style.left = (btnCenter - 8) + 'px';
    }
  }
</script>

<div class="h-16"></div>