<%# app/views/users/_form.html.erb %>
<div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 py-10 px-4">
  <div class="max-w-4xl mx-auto space-y-6">
    
    <%= form_with(model: @user, local: true, validate: true, class: "space-y-6") do |f| %>
      
      <%# ── MAIN EDIT CARD ── %>
      <% if @user.errors.any? %>
          <div class="mb-6 p-4 bg-red-50 border-l-4 border-red-500 rounded-r-xl">
            <ul class="text-xs font-black text-red-700 uppercase tracking-widest list-none">
              <% @user.errors.full_messages.each do |msg| %>
                <li>⚠️ <%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
      <div class="bg-white rounded-3xl border border-gray-200 shadow-xl overflow-hidden">
        
        <%# Enhanced Cover with Pattern %>
        <div class="h-40 bg-gradient-to-br from-[#5D5899] via-[#6B63A8] to-indigo-500 relative overflow-hidden">
          <div class="absolute inset-0 opacity-10"
               style="background-image: radial-gradient(circle at 20% 50%, white 2px, transparent 2px), radial-gradient(circle at 80% 20%, white 2px, transparent 2px); background-size: 40px 40px;">
          </div>
          <%# Floating decorative circles %>
          <div class="absolute top-4 right-8 w-32 h-32 bg-white/5 rounded-full blur-2xl"></div>
          <div class="absolute -bottom-8 left-12 w-40 h-40 bg-indigo-300/10 rounded-full blur-3xl"></div>
        </div>

        <div class="px-8 pb-8">
          <%# Header Section %>
          <div class="flex items-end justify-between -mt-16 mb-8">
            <%# Avatar Preview %>
            <div class="relative group">
              <div class="w-32 h-32 rounded-3xl border-4 border-white shadow-2xl overflow-hidden bg-gradient-to-tr from-indigo-400 to-purple-400 flex items-center justify-center text-white text-4xl font-black">
                <% if @user.avatar&.attached? %>
                  <%= image_tag @user.avatar, class: "w-full h-full object-cover", id: "avatar-preview" %>
                <% else %>
                  <span id="avatar-preview"><%= @user.name&.first&.upcase || @user.email&.first&.upcase || "?" %></span>
                <% end %>
              </div>
              <div class="absolute -bottom-2 -right-2 w-10 h-10 bg-[#5D5899] rounded-full flex items-center justify-center shadow-lg border-4 border-white">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
                </svg>
              </div>
            </div>

            <%# Page Title %>
            <div class="text-right">
              <h1 class="text-3xl font-black text-gray-900 tracking-tight mb-1">Edit Profile</h1>
              <p class="text-sm font-medium text-gray-500">Update your personal information</p>
            </div>
          </div>

          <%# ── PERSONAL INFORMATION SECTION ── %>
          <div class="mb-8">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-[#5D5899] to-indigo-500 flex items-center justify-center shadow-md">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-lg font-black text-gray-900">Personal Information</h2>
                <p class="text-xs text-gray-500">Your name and identity details</p>
              </div>
            </div>

            <div class="space-y-5">
              <%# Name fields in a grid %>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div class="group">
                  <%= f.label :name, "First Name", class: "block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2 group-focus-within:text-[#5D5899] transition-colors" %>
                  <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                      <svg class="w-5 h-5 text-gray-400 group-focus-within:text-[#5D5899] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                      </svg>
                    </div>
                    <%= f.text_field :name, 
                        placeholder: "Enter your first name",
                        class: "w-full pl-12 pr-4 py-4 rounded-2xl border-2 border-gray-200 text-sm font-bold text-gray-800 focus:border-[#5D5899] focus:ring-4 focus:ring-[#5D5899]/10 outline-none transition-all bg-gray-50 focus:bg-white" %>
                  </div>
                </div>

                <div class="group">
                  <%= f.label :lastname, "Last Name", class: "block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2 group-focus-within:text-[#5D5899] transition-colors" %>
                  <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                      <svg class="w-5 h-5 text-gray-400 group-focus-within:text-[#5D5899] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                      </svg>
                    </div>
                    <%= f.text_field :lastname, 
                        placeholder: "Enter your last name",
                        class: "w-full pl-12 pr-4 py-4 rounded-2xl border-2 border-gray-200 text-sm font-bold text-gray-800 focus:border-[#5D5899] focus:ring-4 focus:ring-[#5D5899]/10 outline-none transition-all bg-gray-50 focus:bg-white" %>
                  </div>
                </div>
              </div>

              <%# Username %>
              <div class="group">
                <%= f.label :username, class: "block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2 group-focus-within:text-[#5D5899] transition-colors" %>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                    <span class="text-gray-400 font-bold text-sm group-focus-within:text-[#5D5899] transition-colors">@</span>
                  </div>
                  <%= f.text_field :username, 
                      placeholder: "johndoe",
                      class: "w-full pl-12 pr-4 py-4 rounded-2xl border-2 border-gray-200 text-sm font-bold text-gray-800 focus:border-[#5D5899] focus:ring-4 focus:ring-[#5D5899]/10 outline-none transition-all bg-gray-50 focus:bg-white" %>
                </div>
                <p class="text-xs text-gray-500 mt-2 ml-1">Choose a unique username for your profile</p>
              </div>

              <%# Bio %>
              <div class="group">
                <%= f.label :bio, class: "block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2 group-focus-within:text-[#5D5899] transition-colors" %>
                <%= f.text_area :bio, 
                    rows: 4, 
                    placeholder: "Write a short bio about yourself... What makes you unique?",
                    class: "w-full px-4 py-4 rounded-2xl border-2 border-gray-200 text-sm font-medium text-gray-800 focus:border-[#5D5899] focus:ring-4 focus:ring-[#5D5899]/10 outline-none transition-all resize-none bg-gray-50 focus:bg-white" %>
                <div class="flex justify-between items-center mt-2 px-1">
                  <p class="text-xs text-gray-500">Tell people about yourself</p>
                  <p class="text-xs text-gray-400"><span id="bio-count">0</span> / 500</p>
                </div>
              </div>
            </div>
          </div>

          <%# ── CONTACT INFORMATION SECTION ── %>
          <div class="mb-8 pt-8 border-t border-gray-100">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-500 flex items-center justify-center shadow-md">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-lg font-black text-gray-900">Contact Information</h2>
                <p class="text-xs text-gray-500">How people can reach you</p>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <%# Phone Number %>
              <div class="group">
                <%= f.label :phone_number, "Phone Number", class: "block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2 group-focus-within:text-emerald-600 transition-colors" %>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                    <svg class="w-5 h-5 text-gray-400 group-focus-within:text-emerald-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                    </svg>
                  </div>
                  <%= f.telephone_field :phone_number, 
                      placeholder: "+1 (234) 567-8900",
                      class: "w-full pl-12 pr-4 py-4 rounded-2xl border-2 border-gray-200 text-sm font-bold text-gray-800 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 outline-none transition-all bg-gray-50 focus:bg-white" %>
                </div>
              </div>

              <%# Country %>
              <div class="group">
                <%= f.label :country, class: "block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2 group-focus-within:text-blue-600 transition-colors" %>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                    <svg class="w-5 h-5 text-gray-400 group-focus-within:text-blue-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                  </div>
                  <%= f.text_field :country, 
                      placeholder: "e.g., United States",
                      class: "w-full pl-12 pr-4 py-4 rounded-2xl border-2 border-gray-200 text-sm font-bold text-gray-800 focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 outline-none transition-all bg-gray-50 focus:bg-white" %>
                </div>
              </div>
            </div>
          </div>

          <%# ── ADDITIONAL DETAILS SECTION ── %>
          <div class="mb-8 pt-8 border-t border-gray-100">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-pink-500 to-rose-500 flex items-center justify-center shadow-md">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-lg font-black text-gray-900">Additional Details</h2>
                <p class="text-xs text-gray-500">More about you</p>
              </div>
            </div>

            <div class="space-y-5">
              <%# Date of Birth %>
              <div class="group">
                <%= f.label :date_of_birth, class: "block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2 group-focus-within:text-pink-600 transition-colors" %>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                    <svg class="w-5 h-5 text-gray-400 group-focus-within:text-pink-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                  </div>
                  <%= f.date_field :date_of_birth, 
                      class: "w-full pl-12 pr-4 py-4 rounded-2xl border-2 border-gray-200 text-sm font-bold text-gray-800 focus:border-pink-500 focus:ring-4 focus:ring-pink-500/10 outline-none transition-all bg-gray-50 focus:bg-white" %>
                </div>
              </div>

              <%# Avatar Upload %>
              <div class="group">
                <%= f.label :avatar, "Profile Picture", class: "block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2" %>
                <div class="relative border-2 border-dashed border-gray-300 rounded-2xl p-6 hover:border-[#5D5899] transition-all bg-gray-50 group-hover:bg-white">
                  <div class="text-center">
                    <div class="mx-auto w-16 h-16 rounded-2xl bg-gradient-to-br from-[#5D5899] to-indigo-500 flex items-center justify-center mb-4">
                      <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                      </svg>
                    </div>
                    <div class="mb-4">
                      <p class="text-sm font-bold text-gray-900 mb-1">Upload your profile picture</p>
                      <p class="text-xs text-gray-500">PNG, JPG or GIF (max. 5MB)</p>
                    </div>
                    <%= f.file_field :avatar, 
                        direct_upload: true,
                        accept: "image/*",
                        id: "avatar-upload-field",
                        class: "hidden" %>
                    <label for="avatar-upload-field" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-white border-2 border-gray-300 text-sm font-black text-gray-700 hover:border-[#5D5899] hover:text-[#5D5899] hover:bg-[#5D5899]/5 transition-all cursor-pointer">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
                      </svg>
                      Choose File
                    </label>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <%# ── ACTION BUTTONS ── %>
          <div class="pt-8 border-t border-gray-100">
            <div class="flex flex-col sm:flex-row gap-4">
              <%= f.submit "Save Changes", 
                  class: "flex-1 flex items-center justify-center gap-2 px-8 py-4 rounded-2xl bg-gradient-to-r from-[#5D5899] to-indigo-500 text-white text-sm font-black hover:shadow-2xl hover:scale-[1.02] transition-all shadow-lg shadow-[#5D5899]/30 uppercase tracking-widest cursor-pointer" %>
              
              <%= link_to user_path(@user), 
                  class: "flex-1 sm:flex-initial flex items-center justify-center gap-2 px-8 py-4 rounded-2xl border-2 border-gray-300 text-gray-700 text-sm font-black hover:border-gray-400 hover:bg-gray-50 transition-all uppercase tracking-widest" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                </svg>
                Cancel
              <% end %>
            </div>
            
            <p class="text-center text-xs text-gray-500 mt-6">
              Your information is secure and will never be shared with third parties
            </p>
          </div>

        </div>
      </div>

    <% end %>

    <%# ── HELP CARD ── %>
    

  </div>
</div>

<script>
  // Bio character counter
  document.addEventListener('DOMContentLoaded', function() {
    const bioField = document.querySelector('textarea[name="user[bio]"]');
    const bioCount = document.getElementById('bio-count');
    
    if (bioField && bioCount) {
      bioField.addEventListener('input', function() {
        bioCount.textContent = this.value.length;
      });
      // Initialize count
      bioCount.textContent = bioField.value.length;
    }

    // Avatar preview
    const avatarInput = document.getElementById('avatar-upload-field');
    const avatarPreview = document.getElementById('avatar-preview');
    
    if (avatarInput) {
      avatarInput.addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file) {
          const reader = new FileReader();
          reader.onload = function(e) {
            if (avatarPreview.tagName === 'IMG') {
              avatarPreview.src = e.target.result;
            } else {
              const img = document.createElement('img');
              img.src = e.target.result;
              img.className = 'w-full h-full object-cover';
              avatarPreview.parentElement.innerHTML = '';
              avatarPreview.parentElement.appendChild(img);
            }
          }
          reader.readAsDataURL(file);
        }
      });
    }
  });
</script>