<%# app/views/users/index.html.erb %>

<div class="container mx-auto py-10">
  <h1 class="text-2xl font-black mb-6">User Directory</h1>

  <table class="w-full border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
    <thead class="bg-gray-50 border-b border-gray-100">
      <tr class="text-left text-[10px] uppercase tracking-widest font-bold text-gray-400">
        <th class="p-4">Full Name</th>
        <th class="p-4">Username</th>
        <th class="p-4">Age/Country</th>
        <th class="p-4">Bio</th>
        <th class="p-4">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-50">
      <% @users.each do |user| %>
        <tr class="hover:bg-gray-50/50 transition-colors">
          <td class="p-4">
            <span class="font-bold text-gray-900"><%= user.name %> <%= user.lastname %></span>
          </td>
          <td class="p-4">
            <span class="text-indigo-600 font-medium">@<%= user.username %></span>
          </td>
          <td class="p-4 text-gray-500 text-sm">
            <%= user.date_of_birth %> yrs • <%= user.country %>
          </td>
          <td class="p-4 text-gray-400 text-xs italic truncate max-w-[200px]">
            "<%= user.bio %>"
          </td>
          <td class="p-4">
             <%= link_to "Edit", edit_user_path(user), class: "text-gray-900 underline font-bold text-xs" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>