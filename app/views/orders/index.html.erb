<%= turbo_frame_tag "orders" do %>
  <div class="mx-auto max-w-7xl mt-4 sm:mt-8 p-3 sm:p-6 md:p-8">

    <div class="mb-6">
      <nav class="flex items-center space-x-3 text-[11px] font-black uppercase tracking-[0.15em] text-gray-400 mb-4">
        
        <a href="/" 
          data-turbo-frame="_top"
          class="hover:text-[#5D5899] transition-all flex items-center group">
          
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1.5 opacity-60 group-hover:opacity-100" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          
          Home
        </a>

        <span class="text-gray-600 font-light">/</span>

        <a href="<%= orders_path %>" 
          data-turbo-frame="_top"
          class="text-[#5D5899] opacity-90 transition-all">
          Purchases
        </a>

      </nav>
    </div>

    <%# ── Header ── %>
    <div class="flex items-center gap-3 sm:gap-4 mb-6 sm:mb-8">
      <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-[#5D5899]/10 flex items-center justify-center text-[#5D5899]">
        <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z"/>
        </svg>
      </div>
      <div>
        <h1 class="text-xl sm:text-2xl font-black text-gray-900 tracking-tight">Your Cart</h1>
        <% if @order&.order_items&.any? %>
          <p class="text-sm text-gray-500 mt-1">
            <%= pluralize(@order.order_items.count, 'item') %> in your cart
          </p>
        <% end %>
      </div>
    </div>

    <% if @order&.order_items&.any? %>

      <%# ── Layout: stacked on mobile, side-by-side on desktop ── %>
      <div class="flex flex-col lg:flex-row gap-6 lg:gap-8 items-start">

        <%# ── LEFT: Items List ── %>
        <div class="w-full lg:flex-1 min-w-0">
          <div class="space-y-3 lg:max-h-[70vh] lg:overflow-y-auto lg:pr-2">
            <%= render "order_items/order_items" %>
          </div>
        </div>

        <%# ── RIGHT: Order Summary ── %>
        <div class="w-full lg:w-96 lg:sticky lg:top-8">
          <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
            
            <%# Summary Header %>
            <h2 class="text-lg font-black text-gray-900 mb-6">Order Summary</h2>
            
            <%# Price Breakdown %>
            <div class="space-y-3 mb-6 pb-6 border-b border-gray-100">
              <div class="flex justify-between items-center text-sm">
                <span class="text-gray-600">Subtotal</span>
                <span class="font-semibold text-gray-900">
                  <%= number_to_currency(@order.subtotal || 0) %>
                </span>
              </div>
              
              <% if @order.tax.to_f > 0 %>
                <div class="flex justify-between items-center text-sm">
                  <span class="text-gray-600">Tax</span>
                  <span class="font-semibold text-gray-900">
                    <%= number_to_currency(@order.tax) %>
                  </span>
                </div>
              <% end %>
              
              <% if @order.discount.to_f > 0 %>
                <div class="flex justify-between items-center text-sm text-green-600">
                  <span>Discount</span>
                  <span class="font-semibold">
                    -<%= number_to_currency(@order.discount) %>
                  </span>
                </div>
              <% end %>
            </div>
            
            <%# Total %>
            <div class="flex justify-between items-center mb-6">
              <span class="text-base font-black text-gray-900">Total</span>
              <span class="text-2xl font-black text-[#5D5899]">
                <%= number_to_currency(@order.total || 0) %>
              </span>
            </div>
            
            <%# Checkout Button %>
            <%= link_to "Proceed to Checkout", checkout_path(@order),
                  data: { turbo_frame: "_top" },
                  class: "w-full block text-center px-6 py-4 bg-[#5D5899] text-white rounded-xl
                          font-black text-sm uppercase tracking-[0.15em]
                          hover:bg-[#4e4a85] hover:scale-[1.02] active:scale-95 
                          transition-all shadow-lg shadow-purple-100" %>
            
            <%# Continue Shopping %>
            <%= link_to "Continue Shopping", products_path,
                  data: { turbo_frame: "_top" },
                  class: "w-full block text-center mt-3 px-6 py-3 border-2 border-gray-200 
                          text-gray-700 rounded-xl font-bold text-sm
                          hover:border-[#5D5899] hover:text-[#5D5899] transition-all" %>
          </div>
        </div>

      </div>

    <% else %>

      <%# ── Empty State ── %>
      <div class="bg-white rounded-[2rem] border border-gray-100 shadow-sm py-12 px-6 sm:p-16
                  flex flex-col items-center gap-5 sm:gap-6 text-center">
        <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-[1.5rem] bg-gray-50 border-2 border-dashed border-gray-200
                    flex items-center justify-center">
          <svg class="w-7 h-7 sm:w-9 sm:h-9 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z"/>
          </svg>
        </div>
        <div class="space-y-2">
          <h2 class="text-lg sm:text-xl font-black text-gray-900">Your cart is empty</h2>
          <p class="text-sm text-gray-400 font-semibold max-w-xs mx-auto leading-relaxed">
            Looks like you haven't added anything yet. Explore our products!
          </p>
        </div>
        <%= link_to "Browse Products", products_path,
              data: { turbo_frame: "_top" },
              class: "inline-block px-8 sm:px-10 py-3.5 sm:py-4 bg-[#5D5899] text-white rounded-[1rem]
                      font-black text-xs uppercase tracking-[0.2em]
                      hover:bg-[#4e4a85] hover:scale-105 active:scale-95 transition-all shadow-lg shadow-purple-100" %>
      </div>

    <% end %>
  </div>
<% end %>