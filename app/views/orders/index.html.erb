<div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 py-12 px-4 sm:px-8">
  <div class="max-w-5xl mx-auto">
    
    <%# Breadcrumb %>
    <nav class="flex items-center space-x-3 text-[11px] font-black uppercase tracking-[0.15em] text-gray-400 mb-8">
      <a href="/" class="hover:text-[#5D5899] transition-all flex items-center group">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1.5 opacity-60 group-hover:opacity-100" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        Home
      </a>
      <span class="text-gray-600 font-light">/</span>
      <span class="text-[#5D5899] opacity-90">Purchases</span>
    </nav>
    
    <%# Page Header %>
   <div class="flex items-center gap-3 sm:gap-4 mb-6 sm:mb-8">
      <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-[#5D5899]/10 flex items-center justify-center text-[#5D5899]">
        <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z"/>
        </svg>
      </div>
      
      <div>
        <h1 class="text-xl sm:text-2xl font-black text-gray-900 tracking-tight">Your Purchases</h1>
        <% if @orders.any? %>
          <p class="text-sm text-gray-500 mt-1">
            <%= pluralize(@orders.count, 'purchase') %> completed
          </p>
        <% end %>
      </div>
    </div>

    <% if @orders.any? %>
      <%# Orders List %>
      <div class="space-y-4">
        <% @orders.each do |order| %>
          <% product = order.order_items.first&.product %>
          <% img = product&.images&.first %>
          <% seller_name = product&.user&.name || "Seller" %>

          <div class="bg-white rounded-2xl border border-gray-200 shadow-sm hover:shadow-md transition-all overflow-hidden group">
            <div class="p-6 sm:p-7 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
              <%# Order Info Left Side %>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-4 mb-4">
                  <% if img&.image&.attached? %>
                    <% img.image.analyze unless img.image.analyzed? %>
                    <%= image_tag img.image,
                          class: "w-24 h-24 rounded-3xl object-cover group-hover:scale-105 transition-transform duration-500",
                          loading: "lazy" %>
                  <% else %>
                    <div class="w-24 h-24 rounded-3xl bg-gray-100 flex items-center justify-center text-gray-300">
                      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                        <rect x="3" y="3" width="18" height="18" rx="2"/>
                        <circle cx="8.5" cy="8.5" r="1.5"/>
                        <path d="M21 15l-5-5L5 21"/>
                      </svg>
                    </div>
                  <% end %>

                  <div class="min-w-0">
                    <h3 class="text-[13px] sm:text-[15px] font-black text-gray-900 leading-snug truncate hover:text-[#5D5899] transition-colors">
                      <% if product %>
                        <%= link_to product.title, product_path(product), class: "block truncate" %>
                      <% else %>
                        <span class="block truncate">Order #<%= order.id %></span>
                      <% end %>
                    </h3>

                    <% if product&.user %>
                      <p class="text-[9px] sm:text-[10px] font-bold text-gray-400 uppercase tracking-widest mt-1">
                        <%= link_to seller_name, user_path(product.user),
                                  data: { turbo_frame: "_top" },
                                  class: "hover:text-[#5D5899] transition-colors block truncate" %>
                      </p>
                    <% end %>
                  </div>
                </div>

                <div class="space-y-2">
                  <%# Status Badge %>
                  <div class="inline-flex items-center gap-2">
                    <span class="text-sm font-medium text-gray-500">Status:</span>
                    <% if order.status == "paid" %>
                      <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-emerald-50 border border-emerald-200 rounded-full">
                        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                        <span class="text-xs font-bold text-emerald-700 uppercase tracking-widest">Completed</span>
                      </span>
                    <% elsif order.status == "pending" %>
                      <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-amber-50 border border-amber-200 rounded-full">
                        <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                        <span class="text-xs font-bold text-amber-700 uppercase tracking-widest">Pending</span>
                      </span>
                    <% else %>
                      <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-gray-100 border border-gray-300 rounded-full">
                        <span class="w-2 h-2 rounded-full bg-gray-500"></span>
                        <span class="text-xs font-bold text-gray-700 uppercase tracking-widest"><%= order.status %></span>
                      </span>
                    <% end %>
                  </div>

                  
                </div>

                <% if order.respond_to?(:license) && order.license %>
                  <%# Show only the selected license %>
                  <div class="inline-flex items-center gap-1.5 bg-[#5D5899]/8 border border-[#5D5899]/15 rounded-xl px-2.5 py-1">
                    <span class="text-[9px] sm:text-[10px] font-black text-[#5D5899] uppercase tracking-wider">
                      <%= item.license.title_name %>
                    </span>
                  </div>
                <% end %>
              </div>

              <%# Price & Action Button %>
              <div class="flex flex-col sm:items-end gap-5">

                <!-- Action Buttons -->
                <div class="flex items-center gap-3 bg-white/70 backdrop-blur-md px-2 py-2 rounded-2xl shadow-sm border border-gray-200">
                  
                  <!-- Download -->
                  <button class="flex cursor-pointer items-center gap-2 px-2 py-2 rounded-xl text-gray-600 hover:text-indigo-600 hover:bg-indigo-50 transition-all duration-200 group">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-5 h-5 group-hover:scale-110 transition">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
                    </svg>
                    <span class="text-sm font-medium">Download</span>
                  </button>

                  <!-- Divider -->
                  <div class="w-px h-6 bg-gray-200"></div>

                  <!-- Review -->
                  <button class="flex cursor-pointer items-center gap-2 px-3 py-2 rounded-xl text-gray-600 hover:text-yellow-500 hover:bg-yellow-50 transition-all duration-200 group">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-5 h-5 group-hover:scale-110 transition">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" />
                    </svg>
                    <span class="text-sm font-medium">Review</span>
                  </button>

                </div>

                <!-- Primary Button -->
                <%= link_to order_path(order), class: "flex items-center justify-center gap-2 px-6 py-3 bg-gradient-to-r from-[#5D5899] to-indigo-600 hover:from-indigo-600 hover:to-[#5D5899] text-white text-sm font-semibold rounded-2xl shadow-md hover:shadow-lg transition-all duration-300 active:scale-95" do %>
                  
                  <span>View Details</span>
                  
                  <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                  </svg>

                <% end %>

              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <%# Empty State %>
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm py-16 px-6 sm:px-12 text-center">
        <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl bg-gray-100 flex items-center justify-center mx-auto mb-6">
          <svg class="w-10 h-10 sm:w-12 sm:h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
        </div>
        
        <h2 class="text-2xl font-black text-gray-900 mb-2">No purchases yet</h2>
        <p class="text-gray-600 font-medium mb-8 max-w-md mx-auto">
          You haven't made any purchases yet. Start exploring our digital products and make your first purchase!
        </p>
        
        <%= link_to root_path, class: "inline-flex items-center justify-center gap-2 px-8 py-3 bg-[#5D5899] hover:bg-[#4a4477] text-white font-bold rounded-xl transition-all shadow-md hover:shadow-lg active:scale-95" do %>
          <span>Browse Products</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
          </svg>
        <% end %>
      </div>
    <% end %>

  </div>
</div>