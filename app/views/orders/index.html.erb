<div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 py-12 px-4 sm:px-8">
  <div class="max-w-5xl mx-auto">
    
    <%# Breadcrumb %>
    <nav class="flex items-center space-x-3 text-[11px] font-black uppercase tracking-[0.15em] text-gray-400 mb-8">
      <a href="/" class="hover:text-[#5D5899] transition-all flex items-center group">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1.5 opacity-60 group-hover:opacity-100" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        Home
      </a>
      <span class="text-gray-600 font-light">/</span>
      <span class="text-[#5D5899] opacity-90">Purchases</span>
    </nav>
    
    <%# Page Header %>
   <div class="flex items-center gap-3 sm:gap-4 mb-6 sm:mb-8">
      <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-[#5D5899]/10 flex items-center justify-center text-[#5D5899]">
        <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z"/>
        </svg>
      </div>
      
      <div>
        <h1 class="text-xl sm:text-2xl font-black text-gray-900 tracking-tight">Your Purchases</h1>
        <% if @order_items.any? %>
          <p class="text-sm text-gray-500 mt-1">
            <%= pluralize(@order_items.count, 'product') %> purchased
          </p>
        <% end %>
      </div>
    </div>

    <% if @order_items.any? %>
      <div class="space-y-4">
        <% @order_items.each do |item| %>
          <% product = item.product %>
          <% next unless product %>
          <% order = item.order %>
          <% img = product.images.first %>
          <% license = product.licenses.first %>
          <% download_file = product.product_files.detect { |file| file.attachment.attached? } %>

          <div class="bg-white rounded-2xl border border-gray-200 shadow-sm hover:shadow-md transition-all overflow-hidden group">
            <div class="p-6 sm:p-7 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-4 mb-4">
                  <% if img&.image&.attached? %>
                    <% img.image.analyze unless img.image.analyzed? %>
                    <%= image_tag img.image,
                          class: "w-24 h-24 rounded-3xl object-cover group-hover:scale-105 transition-transform duration-500",
                          loading: "lazy" %>
                  <% else %>
                    <div class="w-24 h-24 rounded-3xl bg-gray-100 flex items-center justify-center text-gray-300">
                      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                        <rect x="3" y="3" width="18" height="18" rx="2"/>
                        <circle cx="8.5" cy="8.5" r="1.5"/>
                        <path d="M21 15l-5-5L5 21"/>
                      </svg>
                    </div>
                  <% end %>

                  <div class="min-w-0">
                    <h3 class="text-[13px] sm:text-[15px] font-black text-gray-900 leading-snug truncate hover:text-[#5D5899] transition-colors">
                      <%= link_to product.title, product_path(product), class: "block truncate" %>
                    </h3>
                    <% if product.user %>
                      <p class="text-[9px] sm:text-[10px] font-bold text-gray-400 uppercase tracking-widest mt-1">
                        <%= link_to product.user.name, user_path(product.user), data: { turbo_frame: "_top" }, class: "hover:text-[#5D5899] transition-colors block truncate" %>
                      </p>
                    <% end %>
                    <p class="text-xs text-gray-400 mt-1">Purchased on <%= order.created_at.strftime("%B %d, %Y") %></p>
                  </div>
                </div>

                <% if license.present? %>
                  <div class="flex flex-wrap gap-2 mb-4">
                    <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#5D5899]/10 text-[#5D5899] text-xs font-bold uppercase tracking-wider">
                      <%= license.title_name %>
                    </span>
                    <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gray-100 text-gray-700 text-xs font-semibold">
                      <%= number_to_currency(license.price, precision: 2, strip_insignificant_zeros: true) %>
                    </span>
                  </div>
                <% end %>

                <%# <p class="text-sm text-gray-600 line-clamp-2 mt-3"><%= product.description.truncate(100) %></p> 
              </div>

              <div class="flex flex-col sm:items-end gap-4">
                <div class="grid grid-cols-2 gap-3">
                  <% if download_file %>
                    <%= link_to rails_blob_path(download_file.attachment, disposition: "attachment"), class: "inline-flex items-center justify-center gap-2 px-4 py-2 rounded-2xl bg-gray-100 text-gray-700 text-sm font-semibold hover:bg-gray-200 transition-all" do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M7 10l5 5 5-5" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 15V3" />
                      </svg>
                      Download
                    <% end %>
                  <% end %>

                  <%= link_to new_product_review_path(product), class: "inline-flex items-center justify-center gap-2 px-4 py-2 rounded-2xl bg-[#5D5899] text-white text-sm font-semibold hover:bg-[#4d4885] transition-all" do %>
                    Review
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <%# Empty State %>
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm py-16 px-6 sm:px-12 text-center">
        <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl bg-gray-100 flex items-center justify-center mx-auto mb-6">
          <svg class="w-10 h-10 sm:w-12 sm:h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
        </div>
        
        <h2 class="text-2xl font-black text-gray-900 mb-2">No purchases yet</h2>
        <p class="text-gray-600 font-medium mb-8 max-w-md mx-auto">
          You haven't made any purchases yet. Start exploring our digital products and make your first purchase!
        </p>
        
        <%= link_to root_path, class: "inline-flex items-center justify-center gap-2 px-8 py-3 bg-[#5D5899] hover:bg-[#4a4477] text-white font-bold rounded-xl transition-all shadow-md hover:shadow-lg active:scale-95" do %>
          <span>Browse Products</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
          </svg>
        <% end %>
      </div>
    <% end %>

  </div>
</div>