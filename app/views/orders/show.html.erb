<div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 py-12 px-4 sm:px-8">
  <div class="max-w-4xl mx-auto">
    
    <%# Breadcrumb %>
    <nav class="flex items-center space-x-3 text-[11px] font-black uppercase tracking-[0.15em] text-gray-400 mb-8">
      <a href="/" class="hover:text-[#5D5899] transition-all flex items-center group">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1.5 opacity-60 group-hover:opacity-100" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        Home
      </a>
      <span class="text-gray-600 font-light">/</span>
      <a href="<%= orders_path %>" class="hover:text-[#5D5899] transition-all">Purchases</a>
      <span class="text-gray-600 font-light">/</span>
      <span class="text-[#5D5899] opacity-90">Order #<%= @order.id %></span>
    </nav>

    <%# Header with Back Button %>
    <div class="flex items-start justify-between gap-4 mb-8">
      <div>
        <h1 class="text-4xl sm:text-5xl font-black text-gray-900 mb-2 tracking-tight">
          Order #<%= @order.id %>
        </h1>
        <p class="text-lg text-gray-600 font-medium">
          Placed on <%= @order.created_at.strftime("%B %d, %Y at %l:%M %p") %>
        </p>
      </div>
      <%= link_to orders_path, class: "inline-flex items-center gap-2 px-4 py-2.5 bg-white hover:bg-gray-50 border border-gray-200 text-gray-700 font-semibold rounded-xl transition-all" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
        <span>Back</span>
      <% end %>
    </div>

    <%# Status Card %>
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 sm:p-8 mb-8">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-8">
        
        <%# Status %>
        <div>
          <p class="text-sm font-medium text-gray-500 uppercase tracking-widest mb-2">Status</p>
          <% if @order.status == "paid" %>
            <div class="inline-flex items-center gap-2 px-4 py-2.5 bg-emerald-50 border border-emerald-200 rounded-xl">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
              <span class="font-bold text-emerald-700">Completed</span>
            </div>
          <% elsif @order.status == "pending" %>
            <div class="inline-flex items-center gap-2 px-4 py-2.5 bg-amber-50 border border-amber-200 rounded-xl">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
              <span class="font-bold text-amber-700">Pending</span>
            </div>
          <% else %>
            <div class="inline-flex items-center gap-2 px-4 py-2.5 bg-gray-100 border border-gray-300 rounded-xl">
              <span class="w-2.5 h-2.5 rounded-full bg-gray-500"></span>
              <span class="font-bold text-gray-700"><%= @order.status.titleize %></span>
            </div>
          <% end %>
        </div>

        <%# Item Count %>
        <div>
          <p class="text-sm font-medium text-gray-500 uppercase tracking-widest mb-2">Items</p>
          <p class="text-3xl font-black text-gray-900"><%= @order.order_items.count %></p>
        </div>

        <%# Total Amount %>
        <div>
          <p class="text-sm font-medium text-gray-500 uppercase tracking-widest mb-2">Total Amount</p>
          <% if @order.payment %>
            <p class="text-3xl font-black text-gray-900">
              $<%= sprintf("%.2f", @order.payment.amount.to_f) %>
            </p>
            <p class="text-xs text-gray-500 font-medium mt-1">
              <%= @order.payment.currency.upcase %>
            </p>
          <% else %>
            <p class="text-3xl font-black text-gray-900">—</p>
          <% end %>
        </div>
      </div>
    </div>

        <%# Order Items Section %>
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden mb-8">
      <div class="px-6 sm:px-8 py-6 sm:py-8 border-b border-gray-100 bg-gradient-to-r from-indigo-50 to-slate-50">
        <h2 class="text-2xl font-black text-gray-900">Purchased Products</h2>
      </div>

      <div class="p-6 sm:p-8 space-y-4">
        <% @order.order_items.each do |item| %>
          <% product = item.product %>
          <% img = product&.images&.first %>
          <div class="grid grid-cols-1 sm:grid-cols-[120px_minmax(0,_1fr)] gap-4 items-center rounded-3xl border border-gray-100 p-4 bg-gray-50">
            <div class="w-full h-28 rounded-3xl overflow-hidden bg-gray-100 flex items-center justify-center">
              <% if img&.image&.attached? %>
                <% img.image.analyze unless img.image.analyzed? %>
                <%= image_tag img.image, class: "w-full h-full object-cover", loading: "lazy" %>
              <% else %>
                <div class="w-full h-full flex items-center justify-center text-gray-300">
                  <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                    <rect x="3" y="3" width="18" height="18" rx="2"/>
                    <circle cx="8.5" cy="8.5" r="1.5"/>
                    <path d="M21 15l-5-5L5 21"/>
                  </svg>
                </div>
              <% end %>
            </div>

            <div class="space-y-3">
              <div>
                <h3 class="text-lg font-black text-gray-900">
                  <% if product %>
                    <%= link_to product.title, product_path(product), class: "hover:text-[#5D5899] transition-colors" %>
                  <% else %>
                    <span class="text-gray-900">Product unavailable</span>
                  <% end %>
                </h3>
                <% if product&.user %>
                  <p class="text-sm text-gray-500">
                    Sold by <%= link_to product.user.name, user_path(product.user), data: { turbo_frame: "_top" }, class: "font-semibold text-gray-700 hover:text-[#5D5899]" %>
                  </p>
                <% end %>
              </div>

              <% if product %>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm text-gray-600">
                  <% if product.category %>
                    <div>
                      <span class="font-semibold text-gray-700">Category:</span>
                      <span><%= product.category.name %></span>
                    </div>
                  <% end %>
                </div>
                <p class="text-sm text-gray-600 line-clamp-2 mt-2"><%= product.description.truncate(120) %></p>
              <% end %>

              <div class="flex flex-wrap items-center gap-2 text-sm text-gray-500">
                <span class="inline-flex items-center gap-2 px-3 py-2 rounded-full border border-gray-200 bg-white">
                  <strong class="text-gray-700">Item ID:</strong>
                  <span><%= item.id %></span>
                </span>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <%# Payment Details (if payment exists) %>
    <% if @order.payment %>
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="px-6 sm:px-8 py-6 sm:py-8 border-b border-gray-100 bg-gradient-to-r from-emerald-50 to-teal-50">
          <h2 class="text-2xl font-black text-gray-900">Payment Information</h2>
        </div>

        <div class="p-6 sm:p-8">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
            
            <%# Left Column %>
            <div class="space-y-6">
              <div>
                <p class="text-sm font-medium text-gray-500 uppercase tracking-widest mb-1">Amount</p>
                <p class="text-3xl font-black text-gray-900">
                  $<%= sprintf("%.2f", @order.payment.amount.to_f) %>
                </p>
              </div>

              <div>
                <p class="text-sm font-medium text-gray-500 uppercase tracking-widest mb-1">Currency</p>
                <p class="text-xl font-bold text-gray-900"><%= @order.payment.currency.upcase %></p>
              </div>
            </div>

            <%# Right Column %>
            <div class="space-y-6">
              <% if @order.payment.stripe_charge_id.present? %>
                <div>
                  <p class="text-sm font-medium text-gray-500 uppercase tracking-widest mb-1">Stripe Charge ID</p>
                  <p class="font-mono text-sm text-gray-900 break-all"><%= @order.payment.stripe_charge_id %></p>
                </div>
              <% end %>

              <div>
                <p class="text-sm font-medium text-gray-500 uppercase tracking-widest mb-1">Payment Date</p>
                <p class="text-lg font-bold text-gray-900"><%= @order.payment.created_at.strftime("%B %d, %Y") %></p>
              </div>
            </div>
          </div>

          <%# Status Badge %>
          <div class="mt-8 pt-8 border-t border-gray-100">
            <div class="inline-flex items-center gap-2 px-4 py-2.5 bg-emerald-50 border border-emerald-200 rounded-xl">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
              <span class="font-bold text-emerald-700">Payment Successful</span>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <%# Action Buttons %>
    <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
      <%= link_to orders_path, class: "flex items-center justify-center gap-2 px-8 py-3 bg-white hover:bg-gray-50 border border-gray-200 text-gray-700 font-bold rounded-xl transition-all shadow-sm hover:shadow-md" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
        <span>Back to Purchases</span>
      <% end %>

      <%= link_to root_path, class: "flex items-center justify-center gap-2 px-8 py-3 bg-[#5D5899] hover:bg-[#4a4477] text-white font-bold rounded-xl transition-all shadow-md hover:shadow-lg active:scale-95" do %>
        <span>Continue Shopping</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
        </svg>
      <% end %>
    </div>

  </div>
</div>