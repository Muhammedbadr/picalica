<div class="max-w-7xl mx-auto mt-8 px-4 py-8">
  
  <%# Breadcrumbs %>
  <div class="mb-8">
    <nav class="flex items-center space-x-3 text-[11px] font-black uppercase tracking-[0.15em] text-gray-400 mb-4">
      <a href="/" class="hover:text-[#5D5899] transition-all flex items-center group">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1.5 opacity-60 group-hover:opacity-100" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        Home
      </a>
      <span class="text-gray-600 font-light">/</span>
      <a href="<%= products_path %>" class="text-[#5D5899] opacity-90 transition-all">My Products</a>
    </nav>
  </div>
  <div class="flex items-center gap-3 sm:gap-4  sm:mb-10">
    
    <!-- Icon -->
    <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-[#5D5899]/10 flex items-center justify-center text-[#5D5899] shadow-sm">
      <!-- Box / Products Icon -->
      <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round"
          d="M21 8.25l-9 5.25L3 8.25M12 13.5V21m0-7.5L3 8.25m9 5.25l9-5.25M3 8.25l9-5.25 9 5.25M12 13.5l6-3.5M12 13.5l-6-3.5" />
      </svg>

    </div>

    <!-- Text -->
      <h1 class="text-xl sm:text-2xl font-black text-gray-900 tracking-tight">
        My Products
      </h1>

  </div>
  <%# Grid %>
  <% if @products.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-5">
      <% @products.each do |product| %>
        <%= render "products/product_card", 
            product: product, 
            label: product.category&.name  %>
      <% end %>
    </div>
  <% else %>
    <div class="col-span-full text-center py-20 bg-gray-50 rounded-2xl border border-dashed border-gray-200">
      <p class="text-base text-gray-400">No products yet.</p>
    </div>
  <% end %>

</div>