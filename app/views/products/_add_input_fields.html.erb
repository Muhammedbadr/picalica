<div class="nested-form-wrapper group relative  md:bg-transparent  md:p-0 rounded-3xl   md:shadow-none">
  
  <%= f.hidden_field :_destroy %>

  <%# Grid: 1 column on mobile, 2 columns on medium screens and up %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">

    <div class="space-y-2">
      <%= f.label :price, "Price (USD)", class: "text-[10px] md:text-[11px] font-black text-gray-400 uppercase tracking-widest ml-1" %>
      <div class="relative">
        <span class="absolute left-6 top-1/2 -translate-y-1/2 text-gray-300 font-black text-lg md:text-xl">$</span>
        <%= f.number_field :price, placeholder: "0.00", step: :any,
            class: "w-full pl-12 pr-6 py-4 rounded-2xl border border-transparent bg-gray-50 outline-none font-black text-lg md:text-xl focus:bg-white focus:border-[#5D5899] transition-all shadow-inner" %>
      </div>
    </div>

    <div class="space-y-2 relative">
      <%= f.label :title_name, "License Type", class: "text-[10px] md:text-[11px] font-black text-gray-400 uppercase tracking-widest ml-1" %>
      
      <div class="flex items-center gap-2 md:gap-4">
        <%= f.select :title_name, ["Personal Use", "Commercial License"], {},
            class: "w-full px-6 py-4 rounded-2xl border border-transparent bg-gray-50 outline-none font-bold text-sm md:text-base focus:bg-white focus:border-[#5D5899] transition-all shadow-inner appearance-none" %>
        <% unless local_assigns[:show_remove] == false %>
            <button type="button" 
                    data-action="nested-form#remove" 
                    class="cursor-pointer flex-shrink-0 bg-red-50 text-red-500 p-3 rounded-xl hover:bg-red-500 hover:text-white transition-all duration-200 group-hover:opacity-100">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 md:h-6 md:w-6 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
            </button>
        <% end %>
      </div>
    </div>
  </div>
</div>