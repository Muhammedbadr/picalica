<%= form_with(model: @product, url: update_step_two_product_path(@product), local: true, validate: true , multipart: true, class: "max-w-5xl mx-auto space-y-10", method: :patch) do |f| %>
  
  <div class="form-section form-2 p-8 md:p-12 space-y-8" id="section-2">
    
    <% if @product.errors.any? %>
      <div class="mb-6 p-4 bg-red-50 border-l-4 border-red-500 rounded-r-xl">
        <ul class="text-xs font-black text-red-700 uppercase tracking-widest list-none">
          <% @product.errors.full_messages.each do |msg| %>
            <li>⚠️ <%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="max-w-5xl mx-auto mb-10 px-4">
      <%# --- BREADCRUMBS --- %>
      <nav class="flex items-center space-x-3 text-[11px] font-black uppercase tracking-[0.15em] text-gray-400 mb-4">
        <a href="/" class="hover:text-[#5D5899] transition-all flex items-center group">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1.5 opacity-60 group-hover:opacity-100" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          Home
        </a>

        <span class="text-gray-600 font-light">/</span>

        <%# This link takes you back to the "New Product" page %>
        
        <%= link_to edit_product_path(@product), class: " hover:text-[#5D5899] transition-all " do %>
          Create New
        <% end %>
        <span class="text-gray-600 font-light">/</span>

        <span class="text-[#5D5899] opacity-90">Editor</span>
      </nav>

      <%# --- PAGE TITLE SECTION --- %>
      
      <div class="space-y-1">
          <h1 class="text-3xl font-black text-gray-900 tracking-tight">
            <%= @product.title.presence || "New Product Specification" %>
          </h1>
          <div class="flex items-center text-sm font-semibold text-gray-500">
            <span class="inline-block w-2 h-2 rounded-full bg-[#5D5899] mr-2"></span>
            Step 2: Media & Content Configuration
          </div>
      </div>
    </div>

    <div class="bg-white rounded-[2rem] mt-6 border border-gray-100 shadow-sm space-y-8 pt-16 -16 p-10">
      <div class="flex items-center space-x-4 border-b border-gray-50 pb-2 ">
        <div class="w-12 h-12 rounded-2xl bg-[#5D5899]/10 flex items-center justify-center text-[#5D5899]">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1M12 12V3m0 0l-3 3m3-3l3 3"/>
          </svg>
        </div>
        <div>
          <h3 class="text-xl font-black text-gray-900 tracking-tight">Upload Product Cover</h3>
          <p class="text-[10px] text-gray-400 font-bold uppercase tracking-widest mt-1">This image will be displayed as the main preview</p>
        </div>
      </div>
      <%# ─── HERO COVER → ─── %>
      <div class="space-y-3">
        <span class="text-[11px] font-black text-gray-400 uppercase tracking-widest ml-1">Main Product Cover</span>

        <div class="relative h-96 bg-gray-50 rounded-[2rem] border-2 border-dashed border-gray-200 flex flex-col items-center justify-center cursor-pointer transition-all duration-300 hover:bg-white hover:border-[#5D5899] overflow-hidden group"
             onclick="document.getElementById('hero-input').click()">

          <img id="hero-preview" class="absolute inset-0 w-full h-full object-cover hidden">

          <%# index [0] = hero cover Image record %>
          <input type="file"
                 id="hero-input"
                 name="product[images_attributes][0][image]"
                 accept="image/*"
                 class="hidden"
                 onchange="previewHeroImage(this)">

          <div id="hero-placeholder" class="flex flex-col items-center gap-4 text-center">
            <div class="w-16 h-16 bg-white rounded-2xl shadow-sm flex items-center justify-center transition-transform duration-300 group-hover:-translate-y-2">
              <svg class="w-8 h-8 text-gray-400" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19.35 10.04A7.49 7.49 0 0012 4C9.11 4 6.6 5.64 5.35 8.04A5.994 5.994 0 000 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM14 13v4h-4v-4H7l5-5 5 5h-3z"/>
              </svg>
            </div>
            <div class="space-y-1">
              <span class="block text-[11px] font-black text-gray-400 uppercase tracking-widest">Upload Product Image</span>
              <%# <p class="text-[10px] text-gray-400">Upload a picture of the produc</p> %>
            </div>
          </div>
        </div>
      </div>
      <%# ─── CONTENT LAYOUT SECTION TITLE ─── %>
      <div class="flex items-center space-x-4 border-b border-gray-50 pb-2 pt-6 ">
        <div class="w-12 h-12 rounded-2xl bg-[#5D5899]/10 flex items-center justify-center text-[#5D5899]">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
        </div>
        <div>
          <h3 class="text-xl font-black text-gray-900 tracking-tight">Content Layout</h3>
          <p class="text-[10px] text-gray-400 font-bold uppercase tracking-widest mt-1">Add and reorder blocks freely</p>
        </div>
      </div>
      <%# ─── BLOCKS CONTAINER ─── %>
      <div id="blocks-container" class="space-y-6">

        <%# TEXT BLOCK — no name attrs, not saving yet %>
        <div class="block-item bg-gray-50/70 rounded-[2rem] border border-gray-100 overflow-hidden flex hover:shadow-md transition-shadow duration-200" data-type="text">
          <div class="flex flex-col items-center justify-center gap-2 px-4 py-6 bg-gray-100/60 border-r border-gray-100 min-w-[50px]">
            <button type="button" onclick="moveBlock(this,-1)" class="cursor-pointer w-8 h-8 rounded-xl bg-white shadow-sm flex items-center justify-center text-gray-400 hover:text-[#5D5899] transition-all">
              <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path d="M14.707 12.707a1 1 0 01-1.414 0L10 9.414l-3.293 3.293a1 1 0 01-1.414-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 010 1.414z"/></svg>
            </button>
            <button type="button" onclick="moveBlock(this,1)" class="cursor-pointer w-8 h-8 rounded-xl bg-white shadow-sm flex items-center justify-center text-gray-400 hover:text-[#5D5899] transition-all">
              <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"/></svg>
            </button>
            <div class="w-6 h-px bg-gray-200 my-1"></div>
            <button type="button" onclick="removeBlock(this)" class="cursor-pointer w-8 h-8 rounded-xl bg-white shadow-sm flex items-center justify-center text-red-300 hover:text-red-500 hover:bg-red-50 transition-all text-xl font-bold">×</button>
            </div>

            <div class="flex-1 p-8 text-left space-y-3">
            <span class="inline-block text-[9px] font-black px-4 py-1 rounded-full bg-violet-100 text-violet-600 tracking-widest uppercase">
              Text Block
            </span>

            <%= f.fields_for :texts do |text_f| %>
              <%# The Title Field %>
              <%= text_f.text_field :title, 
                  value: "Pordcut title ",
                  placeholder: "Section Title",
                  class: "w-full bg-transparent border-none outline-none text-xl font-black text-gray-900 placeholder-gray-300" 
              %>
              <%# The Description Textarea %>
              <%= text_f.text_area :description, 
                  class: "w-full bg-transparent border-none outline-none text-[15px] font-semibold text-gray-500 placeholder-gray-300 leading-relaxed min-h-[60px]", 
                  placeholder: "Enter paragraph content here...", 
                  oninput: "autoResize(this)" 
              %>
            <% end %>
          </div>
        </div>

        <%# LIST BLOCK — no name attrs, not saving yet %>
        <div class="block-item bg-gray-50/70 rounded-[2rem] border border-gray-100 overflow-hidden flex hover:shadow-md transition-shadow duration-200" data-type="list">
          <div class="flex flex-col items-center justify-center gap-2 px-4 py-6 bg-gray-100/60 border-r border-gray-100 min-w-[65px] self-start sticky top-0">
            <button type="button" onclick="moveBlock(this,-1)" class="cursor-pointer w-8 h-8 rounded-xl bg-white shadow-sm flex items-center justify-center text-gray-400 hover:text-[#5D5899] transition-all">
              <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path d="M14.707 12.707a1 1 0 01-1.414 0L10 9.414l-3.293 3.293a1 1 0 01-1.414-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 010 1.414z"/></svg>
            </button>
            <button type="button" onclick="moveBlock(this,1)" class="cursor-pointer w-8 h-8 rounded-xl bg-white shadow-sm flex items-center justify-center text-gray-400 hover:text-[#5D5899] transition-all">
              <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"/></svg>
            </button>
            <div class="w-6 h-px bg-gray-200 my-1"></div>
            <button type="button" onclick="removeBlock(this)" class="cursor-pointer w-8 h-8 rounded-xl bg-white shadow-sm flex items-center justify-center text-red-300 hover:text-red-500 hover:bg-red-50 transition-all text-xl font-bold">×</button>
          </div>

          <div class="flex-1 p-8 text-left space-y-4">
            <span class="inline-block text-[9px] font-black px-4 py-1 rounded-full bg-amber-100 text-amber-600 tracking-widest uppercase">Feature List</span>
            <%= f.fields_for :feature_sections do |fs_f| %>
             
              <%= fs_f.text_field :title, 
                value: "Feature ",
                placeholder: "Section Title",
                class: "w-full bg-transparent border-none outline-none text-xl font-black text-gray-900 placeholder-gray-300" 
              %>
            <% end %>
            <div class="features-list space-y-3"></div>
            <button type="button" onclick="addFeature(this, 0)" class="bg-[#5D5899] text-white px-6 py-2.5 rounded-xl text-[10px] font-black flex items-center gap-2 cursor-pointer"><span>+</span> Add List Item</button>
          </div>
        </div>

        <%# IMAGE BLOCK — index [1] so it does NOT conflict with hero [0] %>
        <div class="block-item bg-gray-50/70 rounded-[2rem] border border-gray-100 overflow-hidden flex hover:shadow-md transition-shadow duration-200" data-type="image">
          <div class="flex flex-col items-center justify-center gap-2 px-4 py-6 bg-gray-100/60 border-r border-gray-100 min-w-[65px] self-start sticky top-0">
            <button type="button" onclick="moveBlock(this,-1)" class="cursor-pointer w-8 h-8 rounded-xl bg-white shadow-sm flex items-center justify-center text-gray-400 hover:text-[#5D5899] transition-all">
              <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path d="M14.707 12.707a1 1 0 01-1.414 0L10 9.414l-3.293 3.293a1 1 0 01-1.414-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 010 1.414z"/></svg>
            </button>
            <button type="button" onclick="moveBlock(this,1)" class="cursor-pointer w-8 h-8 rounded-xl bg-white shadow-sm flex items-center justify-center text-gray-400 hover:text-[#5D5899] transition-all">
              <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"/></svg>
            </button>
            <div class="w-6 h-px bg-gray-200 my-1"></div>
            <button type="button" onclick="removeBlock(this)" class="cursor-pointer w-8 h-8 rounded-xl bg-white shadow-sm flex items-center justify-center text-red-300 hover:text-red-500 hover:bg-red-50 transition-all text-xl font-bold">×</button>
          </div>

          <div class="flex-1 p-8 text-left space-y-4">
            <span class="inline-block text-[9px] font-black px-4 py-1 rounded-full bg-blue-100 text-blue-600 tracking-widest uppercase">Image Gallery</span>
            
            <%# index [1] — separate from hero which is [0] %>
            <input type="text"
                   name="product[images_attributes][1][title]"
                   placeholder="Add title"
                   value="Gallery Images"
                   class="block-heading w-full bg-transparent border-none outline-none text-xl font-black text-gray-900 placeholder-gray-300 mb-4">

            <div id="gallery-grid" class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-4">
            </div>

            <div class="mt-4">
              <div class="relative size-32 bg-gray-50 rounded-3xl border-2 border-dashed border-gray-200 flex flex-col items-center justify-center cursor-pointer hover:border-blue-400 hover:bg-white transition-all group"
                   onclick="document.getElementById('gallery-input').click()">

                <%# index [1] pictures — separate Image record from hero %>
                <input type="file"
                       id="gallery-input"
                       name="product[images_attributes][1][pictures][]"
                       multiple
                       accept="image/*"
                       class="hidden"
                       onchange="handleMultipleImages(this, 'gallery-grid')">

                <div class="flex flex-col items-center gap-2 text-gray-400 group-hover:text-blue-500">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                  </svg>
                  <span class="text-[10px] font-black uppercase">Add Images</span>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
      <%# ─── ADD NEW SECTION BUTTONS ─── %>
      <div class="bg-gray-100/60 rounded-[2.5rem] p-8 space-y-6">
        <span class="block text-[10px] font-black text-gray-400 uppercase tracking-[0.3em] text-center">Add New Section</span>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <button type="button" onclick="addBlock('text')" class="cursor-pointer bg-white rounded-3xl p-6 flex flex-col items-center gap-3 border border-gray-100 shadow-sm hover:shadow-lg hover:border-[#5D5899]/30 hover:-translate-y-1 transition-all group">
            <div class="w-12 h-12 rounded-2xl bg-violet-50 flex items-center justify-center text-violet-600">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path d="M4 6h16M4 12h16M4 18h10"/></svg>
            </div>
            <span class="text-xs font-black text-gray-700 group-hover:text-[#5D5899]">TEXT</span>
          </button>
          <button type="button" onclick="addBlock('list')" class="cursor-pointer bg-white rounded-3xl p-6 flex flex-col items-center gap-3 border border-gray-100 shadow-sm hover:shadow-lg hover:border-[#5D5899]/30 hover:-translate-y-1 transition-all group">
            <div class="w-12 h-12 rounded-2xl bg-amber-50 flex items-center justify-center text-amber-600">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
            </div>
            <span class="text-xs font-black text-gray-700 group-hover:text-[#5D5899]">LIST</span>
          </button>
          <button type="button" onclick="addBlock('image')" class="cursor-pointer bg-white rounded-3xl p-6 flex flex-col items-center gap-3 border border-gray-100 shadow-sm hover:shadow-lg hover:border-[#5D5899]/30 hover:-translate-y-1 transition-all group">
            <div class="w-12 h-12 rounded-2xl bg-blue-50 flex items-center justify-center text-blue-600">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
            </div>
            <span class="text-xs font-black text-gray-700 group-hover:text-[#5D5899]">IMAGES</span>
          </button>
          <button type="button" onclick="addBlock('video')" class="cursor-pointer bg-white rounded-3xl p-6 flex flex-col items-center gap-3 border border-gray-100 shadow-sm hover:shadow-lg hover:border-[#5D5899]/30 hover:-translate-y-1 transition-all group">
            <div class="w-12 h-12 rounded-2xl bg-red-50 flex items-center justify-center text-red-500">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </div>
            <span class="text-xs font-black text-gray-700 group-hover:text-[#5D5899]">VIDEO</span>
          </button>
        </div>
      </div>
      <%# ─── SUBMIT BUTTONS ─── %>
      <div class="flex justify-between items-center pt-6">
        <%= link_to edit_product_path(@product), class: "cursor-pointer text-[11px] font-black text-gray-400 hover:text-gray-900 uppercase tracking-widest transition-colors px-8 py-4 rounded-2xl hover:bg-gray-50" do %>
          ← Move to back
        <% end %>
        <button class="px-12 py-5 bg-[#79C343] text-white rounded-[2rem] font-black text-xs uppercase tracking-[0.2em] shadow-xl shadow-green-100 hover:scale-105 hover:bg-[#6ab038] active:scale-95 transition-all cursor-pointer">
          Publish Product ✓
        </button>
      </div>
    </div>
  </div>

<% end %>
<script>
  function handleMultipleImages(input, gridId) {
    const grid = document.getElementById(gridId);
    if (input.files) {
      Array.from(input.files).forEach((file) => {
        const reader = new FileReader();
        reader.onload = function(e) {
          const wrapper = document.createElement('div');
          wrapper.className = "relative aspect-square rounded-2xl overflow-hidden border border-gray-100 shadow-sm group";
          wrapper.innerHTML = `
            <img src="${e.target.result}" class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
              <button type="button" onclick="this.closest('.relative').remove()"
                      class="bg-white p-2 rounded-full text-red-500 hover:scale-110 transition-transform shadow-lg">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                </svg>
              </button>
            </div>`;
          grid.appendChild(wrapper);
        };
        reader.readAsDataURL(file);
      });
    }
  }

  function addBlock(type) {
    const container = document.getElementById('blocks-container');
    const div = document.createElement('div');
    div.className = 'block-item bg-gray-50/70 rounded-[2rem] border border-gray-100 overflow-hidden flex hover:shadow-md transition-shadow duration-200';
    div.dataset.type = type;

    // uid = unique number — used as index for image blocks
    const uid = Date.now();

    const controls = `
      <div class="flex flex-col items-center justify-center gap-2 px-4 py-6 bg-gray-100/60 border-r border-gray-100 min-w-[50px]">
        <button type="button" onclick="moveBlock(this,-1)" class="cursor-pointer w-8 h-8 rounded-xl bg-white shadow-sm flex items-center justify-center text-gray-400 hover:text-[#5D5899] transition-all">
          <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path d="M14.707 12.707a1 1 0 01-1.414 0L10 9.414l-3.293 3.293a1 1 0 01-1.414-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 010 1.414z"/></svg>
        </button>
        <button type="button" onclick="moveBlock(this,1)" class="cursor-pointer w-8 h-8 rounded-xl bg-white shadow-sm flex items-center justify-center text-gray-400 hover:text-[#5D5899] transition-all">
          <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"/></svg>
        </button>
        <div class="w-6 h-px bg-gray-200 my-1"></div>
        <button type="button" onclick="removeBlock(this)" class="cursor-pointer w-8 h-8 rounded-xl bg-white shadow-sm flex items-center justify-center text-red-300 hover:text-red-500 hover:bg-red-50 transition-all text-xl font-bold">×</button>
      </div>`;

    let bodyHTML = '';

    if (type === 'text') {
      bodyHTML = `
        <div class="flex-1 p-8 text-left space-y-3">
          <span class="inline-block text-[9px] font-black px-4 py-1 rounded-full bg-violet-100 text-violet-600 tracking-widest uppercase">
            Text
          </span>
          <!-- Title Input: Maps to :title -->
          <input type="text" 
                name="product[texts_attributes][${uid}][title]" 
                placeholder="Section Title" 
                class="w-full bg-transparent border-none outline-none text-xl font-black text-gray-900 placeholder-gray-300">
          
          <!-- Description Textarea: Maps to :description -->
          <textarea name="product[texts_attributes][${uid}][description]" 
                    class="w-full bg-transparent border-none outline-none text-[15px] font-semibold text-gray-500 placeholder-gray-300 leading-relaxed min-h-[48px]" 
                    placeholder="Write content..." 
                    oninput="autoResize(this)"></textarea>
        </div>`;
    } else if (type === 'list') {
      bodyHTML = `
        <div class="flex-1 p-8 text-left space-y-4">
          <span class="inline-block text-[9px] font-black px-4 py-1 rounded-full bg-amber-100 text-amber-600 tracking-widest uppercase">Feature List</span>
          
          <input type="text" 
                name="product[feature_sections_attributes][${uid}][title]" 
                placeholder="Section Title" 
                class="w-full bg-transparent border-none outline-none text-xl font-black text-gray-900 placeholder-gray-300">
          
          <div class="features-list space-y-3"></div>
          
          <button type="button" 
                  onclick="addFeature(this, ${uid})" 
                  class="bg-[#5D5899] text-white px-6 py-2.5 rounded-xl text-[10px] font-black flex items-center gap-2 cursor-pointer">
            <span>+</span> Add List Item
          </button>
          
        </div>`;
    } else if (type === 'image') {
      // uid is the index — every new image block gets a unique number
      // so they save as separate Image records in the database
      bodyHTML = `
        <div class="flex-1 p-8 text-left space-y-4">
          <span class="inline-block text-[9px] font-black px-4 py-1 rounded-full bg-blue-100 text-blue-600 tracking-widest uppercase">Image Gallery</span>

          <input type="text"
                name="product[images_attributes][${uid}][title]"
                placeholder="Gallery Title"
                class="block-heading w-full bg-transparent border-none outline-none text-xl font-black text-gray-900 placeholder-gray-300 mb-4">

          <div id="grid-${uid}" class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-4">
          </div>

          <div class="mt-4">
            <div class="relative size-32 bg-gray-50 rounded-3xl border-2 border-dashed border-gray-200 flex flex-col items-center justify-center cursor-pointer hover:border-blue-400 hover:bg-white transition-all group"
                onclick="document.getElementById('input-${uid}').click()">

              <input type="file"
                    id="input-${uid}"
                    name="product[images_attributes][${uid}][pictures][]"
                    multiple
                    accept="image/*"
                    class="hidden"
                    onchange="handleMultipleImages(this, 'grid-${uid}')">

              <div class="flex flex-col items-center gap-2 text-gray-400 group-hover:text-blue-500">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                </svg>
                <span class="text-[10px] font-black uppercase">Add Images</span>
              </div>
            </div>
          </div>
        </div>`;

    } else if (type === 'video') {
      bodyHTML = `
        <div class="flex-1 p-8 text-left space-y-3">
          <span class="inline-block text-[9px] font-black px-4 py-1 rounded-full bg-red-100 text-red-500 tracking-widest uppercase">Video</span>
      
          <input type="text" 
                  name="product[videos_attributes][${uid}][title]" 
                  placeholder="Video Title" 
             class="w-full bg-transparent border-none outline-none text-xl font-black text-gray-900 placeholder-gray-300 mb-2">

          <input type="url" 
                  name="product[videos_attributes][${uid}][link]" 
                  placeholder="https://youtube.com/watch?v=..." 
                  class="w-full bg-transparent border-none outline-none text-sm font-semibold text-gray-700">
             
          <!-- The textarea for content was removed from here -->
        </div>`;
    }

    div.innerHTML = controls + bodyHTML;
    container.appendChild(div);
  }

  function removeBlock(btn) {
    const block = btn.closest('.block-item');
    block.style.opacity = '0';
    setTimeout(() => block.remove(), 250);
  }

  function moveBlock(btn, dir) {
    const block = btn.closest('.block-item');
    const container = document.getElementById('blocks-container');
    const items = [...container.querySelectorAll('.block-item')];
    const idx = items.indexOf(block);
    const target = idx + dir;
    if (target >= 0 && target < items.length) {
      if (dir === -1) container.insertBefore(block, items[target]);
      else container.insertBefore(items[target], block);
    }
  }

  function previewHeroImage(input) {
      const preview = document.getElementById('hero-preview');
      const placeholder = document.getElementById('hero-placeholder');
      if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
          preview.src = e.target.result;
          preview.classList.remove('hidden');
          placeholder.classList.add('hidden');
        };
        reader.readAsDataURL(input.files[0]);
      }
  }

  function addFeature(btn, sectionIndex) {
  const list = btn.previousElementSibling;
  const itemIndex = new Date().getTime(); 
  
  const item = document.createElement('div');
  item.className = 'feature-item flex items-start gap-4 border-l-[4px] border-[#5D5899] pl-6 py-1';
  
  item.innerHTML = `
    <div class="flex-1">
    
      <input type="text" 
            name="product[feature_sections_attributes][${sectionIndex}][feature_items_attributes][${itemIndex}][item_title]" 
            placeholder="Item Title"
            class="w-full bg-transparent border-none outline-none text-base font-black text-gray-900 block mb-1">
      
      <textarea name="product[feature_sections_attributes][${sectionIndex}][feature_items_attributes][${itemIndex}][description]" 
                placeholder="Item Description" 
                class="w-full bg-transparent border-none outline-none text-base font-semibold text-gray-600 min-h-[28px]" 
                oninput="autoResize(this)"></textarea>
    </div>
    <button type="button" onclick="this.parentElement.remove()" class="text-gray-300 hover:text-red-500 text-xl font-bold">×</button>
  `;

  list.appendChild(item);
  }

  function autoResize(el) {
    el.style.height = 'auto';
    el.style.height = el.scrollHeight + 'px';
  }
</script>
