<%= form_with(model: @product, url: update_step_two_product_path(@product),class: "max-w-5xl mx-auto space-y-10 " , method: :patch) do |f| %>
  <div>
    <div class="form-section form-2  p-8 md:p-12 space-y-8" id="section-2">
      <div class="bg-white rounded-[2rem] mt-6 border border-gray-100 shadow-sm space-y-8 p-10">
        
        <%# title for product page content with icone %>
        <div class="flex items-center space-x-4 border-b border-gray-50 pb-6">
          <div class="w-12 h-12 rounded-2xl bg-[#5D5899]/10 flex items-center justify-center text-[#5D5899]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-black text-gray-900 tracking-tight">Product Page Content</h3>
            <p class="text-[10px] text-gray-400 font-bold uppercase tracking-widest mt-1">Cover Image & Content Sections</p>
          </div>
        </div>

        <%# input show main image for product  %>
        <div class="space-y-3">
            <span class="text-[11px] font-black text-gray-400 uppercase tracking-widest ml-1">Main Product Cover</span>
            
            <%# الحاوية الرئيسية %>
            <div class="relative h-96 bg-gray-50 rounded-[2rem] border-2 border-dashed border-gray-200 flex flex-col items-center justify-center cursor-pointer transition-all duration-300 hover:bg-white hover:border-[#5D5899] overflow-hidden group"
              onclick="document.getElementById('hero-input').click()">
            
            <%# المعاينة (تظهر فقط عند اختيار صورة) %>
            <img id="hero-preview" class="absolute inset-0 w-full h-full object-cover hidden">

            <%# حقل رفع الملفات الخاص بـ Rails %>
            <%= f.file_field :picture, 
                  id: "hero-input", 
                  accept: "image/*", 
                  class: "hidden", 
                  onchange: "previewHeroImage(this)" %>

            <%# العناصر التي تختفي عند المعاينة %>
            <div id="hero-placeholder" class="flex flex-col items-center gap-4 text-center">
              <div class="w-16 h-16 bg-white rounded-2xl shadow-sm flex items-center justify-center transition-transform duration-300 group-hover:-translate-y-2">
                <svg class="w-8 h-8 text-gray-400" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M19.35 10.04A7.49 7.49 0 0012 4C9.11 4 6.6 5.64 5.35 8.04A5.994 5.994 0 000 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM14 13v4h-4v-4H7l5-5 5 5h-3z"/>
                </svg>
              </div>
              <div class="space-y-1">
                <span class="block text-[11px] font-black text-gray-400 uppercase tracking-widest">Upload Product Image</span>
                <p class="text-[10px] text-gray-400">PNG, JPG up to 10MB</p>
              </div>
            </div>
          </div>
        </div>

        <%# title with icone for content layout section %>
        <div class="flex items-center space-x-4 border-b border-gray-50 pb-6 pt-4">
          <div class="w-12 h-12 rounded-2xl bg-[#5D5899]/10 flex items-center justify-center text-[#5D5899]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-black text-gray-900 tracking-tight">Content Layout</h3>
            <p class="text-[10px] text-gray-400 font-bold uppercase tracking-widest mt-1">Add and reorder blocks freely</p>
          </div>
        </div>

        <%# inputs %>
        <div id="blocks-container" class="space-y-6">
          <%# Text block %>
          <div class="block-item slide-in bg-gray-50/70 rounded-[2rem] border border-gray-100 overflow-hidden flex transition-shadow duration-200 hover:shadow-md" data-type="text">
            <div class="flex flex-col items-center justify-center gap-2 px-4 py-6 bg-gray-100/60 border-r border-gray-100 min-w-[50px]">
              <button type="button" onclick="moveBlock(this,-1)" class="cursor-pointer w-8 h-8 rounded-xl bg-white shadow-sm flex items-center justify-center text-gray-400 hover:text-[#5D5899] transition-all">
                <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path d="M14.707 12.707a1 1 0 01-1.414 0L10 9.414l-3.293 3.293a1 1 0 01-1.414-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 010 1.414z"/></svg>
              </button>
              <button type="button" onclick="moveBlock(this,1)" class="cursor-pointer w-8 h-8 rounded-xl bg-white shadow-sm flex items-center justify-center text-gray-400 hover:text-[#5D5899] transition-all">
                <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"/></svg>
              </button>
              <div class="w-6 h-px bg-gray-200 my-1"></div>
              <button type="button" onclick="removeBlock(this)" class="cursor-pointer w-8 h-8 rounded-xl bg-white shadow-sm flex items-center justify-center text-red-300 hover:text-red-500 hover:bg-red-50 transition-all text-xl font-bold">×</button>
            </div>
          
            <div class="flex-1 p-8 text-left space-y-3">
              <span class="inline-block text-[9px] font-black px-4 py-1 rounded-full bg-violet-100 text-violet-600 tracking-widest uppercase">Text Block</span>
              <input type="text" value="About Product" class="block-heading w-full bg-transparent border-none outline-none text-xl font-black text-gray-900 placeholder-gray-300">
              <textarea class="block-textarea w-full bg-transparent border-none outline-none text-[15px] font-semibold text-gray-500 placeholder-gray-300 leading-relaxed min-h-[60px]" placeholder="Enter paragraph content here..." oninput="autoResize(this)"></textarea>
            </div>

          </div>
          <%# List block   %>
          <div class="block-item slide-in bg-gray-50/70 rounded-[2rem] border border-gray-100 overflow-hidden flex transition-shadow duration-200 hover:shadow-md" data-type="text">
            
            <div class="flex flex-col items-center justify-center gap-2 px-4 py-6 bg-gray-100/60 border-r border-gray-100 min-w-[65px] self-start sticky top-0">
              <button type="button" onclick="moveBlock(this,-1)" class="cursor-pointer w-8 h-8 rounded-xl bg-white shadow-sm flex items-center justify-center text-gray-400 hover:text-[#5D5899] transition-all hover:shadow-md">
                  <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path d="M14.707 12.707a1 1 0 01-1.414 0L10 9.414l-3.293 3.293a1 1 0 01-1.414-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 010 1.414z"/></svg>
              </button>
              
              <button type="button" onclick="moveBlock(this,1)" class="cursor-pointer w-8 h-8 rounded-xl bg-white shadow-sm flex items-center justify-center text-gray-400 hover:text-[#5D5899] transition-all hover:shadow-md">
                  <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"/></svg>
              </button>
              
              <div class="w-6 h-px bg-gray-200 my-1"></div>
              
              <button type="button" onclick="removeBlock(this)" class="cursor-pointer w-8 h-8 rounded-xl bg-white shadow-sm flex items-center justify-center text-red-300 hover:text-red-500 hover:bg-red-50 transition-all text-xl font-bold hover:shadow-md">×</button>
            </div>
            
            <div class="flex-1 p-8 text-left space-y-4">
              <span class="inline-block text-[9px] font-black px-4 py-1 rounded-full bg-amber-100 text-amber-600 tracking-widest uppercase">Feature List</span>
              <input type="text" value="Features" class="block-heading w-full bg-transparent border-none outline-none text-xl font-black text-gray-900 placeholder-gray-300">
              <input  type="text" placeholder="Item title" class="block-heading w-full bg-transparent border-none outline-none text-xl font-black text-gray-900 placeholder-gray-300">
              <input type="text" placeholder="Write a description for this item" class="block-heading w-full bg-transparent border-none outline-none text-sm font-black text-gray-900 placeholder-gray-300">
              <div class="features-list space-y-3"></div>
              <button type="button" onclick="addFeature(this)" class="bg-[#5D5899] text-white px-6 py-2.5 rounded-xl text-[10px] font-black flex items-center gap-2 cursor-pointer"><span>+</span> Add List Item</button>
            </div>
          </div>
          <%# Image block   %>
          <div class="block-item slide-in bg-gray-50/70 rounded-[2rem] border border-gray-100 overflow-hidden flex transition-shadow duration-200 hover:shadow-md" data-type="text">
            <div class="flex flex-col items-center justify-center gap-2 px-4 py-6 bg-gray-100/60 border-r border-gray-100 min-w-[65px] self-start sticky top-0">
              <button type="button" onclick="moveBlock(this,-1)" class="cursor-pointer w-8 h-8 rounded-xl bg-white shadow-sm flex items-center justify-center text-gray-400 hover:text-[#5D5899] transition-all hover:shadow-md">
                  <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path d="M14.707 12.707a1 1 0 01-1.414 0L10 9.414l-3.293 3.293a1 1 0 01-1.414-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 010 1.414z"/></svg>
              </button>
              
              <button type="button" onclick="moveBlock(this,1)" class="cursor-pointer w-8 h-8 rounded-xl bg-white shadow-sm flex items-center justify-center text-gray-400 hover:text-[#5D5899] transition-all hover:shadow-md">
                  <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"/></svg>
              </button>
              
              <div class="w-6 h-px bg-gray-200 my-1"></div>
              
              <button type="button" onclick="removeBlock(this)" class="cursor-pointer w-8 h-8 rounded-xl bg-white shadow-sm flex items-center justify-center text-red-300 hover:text-red-500 hover:bg-red-50 transition-all text-xl font-bold hover:shadow-md">×</button>
            </div>
          
            <div class="flex-1 p-8 text-left space-y-4">
              <span class="inline-block text-[9px] font-black px-4 py-1 rounded-full bg-blue-100 text-blue-600 tracking-widest uppercase">Image Gallery</span>
              <%# <input type="text"  class="block-heading w-full bg-transparent border-none outline-none text-xl font-black text-gray-900 placeholder-gray-300"> %>
              <%= f.text_field :title, 
                placeholder: "Add title", 
                placeholder: "Add title",
                    class: "block-heading w-full bg-transparent border-none outline-none text-xl
                           font-black text-gray-900 placeholder-gray-300 mb-4" %>
              <div id="grid-${uid}" class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-4">
              </div>
                <%# <%= f.file_field :images, multiple: true , style: " display: block" %> %>
                    <%= f.fields_for :images do |image_form| %>
                      <%= image_form.file_field :images, multiple: true ,  style: " display: block"%>
                    <% end %>
              <div class="mt-4">
                <%# <div class="relative size-32 bg-gray-50 rounded-3xl border-2 border-dashed border-gray-200 flex flex-col items-center justify-center cursor-pointer hover:border-blue-400 hover:bg-white transition-all group" 
                    onclick="document.getElementById('${uid}').click()">
                  <%= f.text_field :images id="${uid}" 
                        name="product[product_images_attributes][][images][]" 
                        multiple 
                        accept="image/*" 
                        class="hidden" 
                        onchange="handleMultipleImages(this, 'grid-${uid}')"
                  <div type="button" class="flex flex-col items-center gap-2 text-gray-400 group-hover:text-blue-500">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-6">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    <span class="text-[10px] font-black uppercase" >Add Images</span>
                  </div>
                </div> %>
              </div>
            </div>
          </div>
        </div>
        
        <%# Add more Feature %>
        <div class="bg-gray-100/60 rounded-[2.5rem] p-8 space-y-6">
          <span class="block text-[10px] font-black text-gray-400 uppercase tracking-[0.3em] text-center">Add New Section</span>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            
            <button type="button" onclick="addBlock('text')" class="cursor-pointer bg-white rounded-3xl p-6 flex flex-col items-center gap-3 border border-gray-100 shadow-sm hover:shadow-lg hover:border-[#5D5899]/30 hover:-translate-y-1 transition-all group">
              <div class="w-12 h-12 rounded-2xl bg-violet-50 flex items-center justify-center text-violet-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path d="M4 6h16M4 12h16M4 18h10"/></svg>
              </div>
              <span class="text-xs font-black text-gray-700 group-hover:text-[#5D5899]">TEXT</span>
            </button>

            <button type="button" onclick="addBlock('list')" class="cursor-pointer bg-white rounded-3xl p-6 flex flex-col items-center gap-3 border border-gray-100 shadow-sm hover:shadow-lg hover:border-[#5D5899]/30 hover:-translate-y-1 transition-all group">
              <div class="w-12 h-12 rounded-2xl bg-amber-50 flex items-center justify-center text-amber-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
              </div>
              <span class="text-xs font-black text-gray-700 group-hover:text-[#5D5899]">LIST</span>
            </button>

            <button type="button" onclick="addBlock('image')" class="cursor-pointer bg-white rounded-3xl p-6 flex flex-col items-center gap-3 border border-gray-100 shadow-sm hover:shadow-lg hover:border-[#5D5899]/30 hover:-translate-y-1 transition-all group">
              <div class="w-12 h-12 rounded-2xl bg-blue-50 flex items-center justify-center text-blue-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
              </div>
              <span class="text-xs font-black text-gray-700 group-hover:text-[#5D5899]">IMAGES</span>
            </button>

            <button type="button" onclick="addBlock('video')" class="cursor-pointer bg-white rounded-3xl p-6 flex flex-col items-center gap-3 border border-gray-100 shadow-sm hover:shadow-lg hover:border-[#5D5899]/30 hover:-translate-y-1 transition-all group">
              <div class="w-12 h-12 rounded-2xl bg-red-50 flex items-center justify-center text-red-500">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </div>
              <span class="text-xs font-black text-gray-700 group-hover:text-[#5D5899]">VIDEO</span>
            </button>

          </div>
        </div>

        <%# submit and back button %>
        <div class="flex justify-between items-center pt-6">
          <%= link_to edit_product_path(@product), class: "cursor-pointer text-[11px] font-black text-gray-400 hover:text-gray-900 uppercase tracking-widest transition-colors px-8 py-4 rounded-2xl hover:bg-gray-50" do %>
            ← Move to back
          <% end %>
          <button class="px-12 py-5 bg-[#79C343] text-white rounded-[2rem] font-black text-xs uppercase tracking-[0.2em] shadow-xl shadow-green-100 hover:scale-105 hover:bg-[#6ab038] active:scale-95 transition-all cursor-pointer">
            Publish Product ✓
          </button>
        </div>

      </div>
    </div>
  </div>
<% end %>


<script>
  // User picks imagesShows preview thumbnails
  function handleMultipleImages(input, gridId) {
    const grid = document.getElementById(gridId);
    
    if (input.files) {
      Array.from(input.files).forEach((file) => {
        const reader = new FileReader();
        
        reader.onload = function(e) {
          const wrapper = document.createElement('div');
          wrapper.className = "relative aspect-square rounded-2xl overflow-hidden border border-gray-100 shadow-sm group animate-in zoom-in-95 duration-200";
          
          wrapper.innerHTML = `
            <img src="${e.target.result}" class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
              <button type="button" 
                      onclick="this.closest('.relative').remove()" 
                      class="bg-white p-2 rounded-full text-red-500 hover:scale-110 transition-transform shadow-lg">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>
          `;
          
          grid.appendChild(wrapper);
        };
        
        reader.readAsDataURL(file);
      });
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    // كود معاينة صورة الغلاف فقط (لأن كود الـ checkbox غير موجود عندك)
    const heroInput = document.getElementById('hero-input');
    if (heroInput) {
      heroInput.addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = ev => {
          const img = document.getElementById('hero-preview');
          img.src = ev.target.result;
          img.classList.remove('hidden');
          document.getElementById('hero-placeholder').classList.add('hidden');
        };
        reader.readAsDataURL(file);
      });
    }
  });
  //Click TEXT/LIST/IMAGE/VIDEOCreates new content block
  function addBlock(type) {
    const container = document.getElementById('blocks-container');
    const div = document.createElement('div');
    div.className = 'block-item slide-in bg-gray-50/70 rounded-[2rem] border border-gray-100 overflow-hidden flex transition-shadow duration-200 hover:shadow-md';
    div.dataset.type = type;
    const uid = 'f' + Date.now();

    const controls = `
      <div class="flex flex-col items-center justify-center gap-2 px-4 py-6 bg-gray-100/60 border-r border-gray-100 min-w-[50px]">
        <button type="button" onclick="moveBlock(this,-1)" class="cursor-pointer w-8 h-8 rounded-xl bg-white shadow-sm flex items-center justify-center text-gray-400 hover:text-[#5D5899] transition-all">
          <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path d="M14.707 12.707a1 1 0 01-1.414 0L10 9.414l-3.293 3.293a1 1 0 01-1.414-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 010 1.414z"/></svg>
        </button>
        <button type="button" onclick="moveBlock(this,1)" class="cursor-pointer w-8 h-8 rounded-xl bg-white shadow-sm flex items-center justify-center text-gray-400 hover:text-[#5D5899] transition-all">
          <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a１ １ ０１０－１．４１４ｚ"/></svg>
        </button>
        <div class="w-6 h-px bg-gray-200 my-1"></div>
        <button type="button" onclick="removeBlock(this)" class="cursor-pointer w-8 h-8 rounded-xl bg-white shadow-sm flex items-center justify-center text-red-300 hover:text-red-500 hover:bg-red-50 transition-all text-xl font-bold">×</button>
      </div>`;

    let bodyHTML = '';
    if (type === 'text') {
      bodyHTML = `<div class="flex-1 p-8 text-left space-y-3">
          <span class="inline-block text-[9px] font-black px-4 py-1 rounded-full bg-violet-100 text-violet-600 tracking-widest uppercase">Text</span>
          <input type="text" placeholder="Section Title" class="block-heading w-full bg-transparent border-none outline-none text-xl font-black text-gray-900 placeholder-gray-300">
          <textarea class="block-textarea w-full bg-transparent border-none outline-none text-[15px] font-semibold text-gray-500 placeholder-gray-300 leading-relaxed min-h-[48px]" placeholder="Write content..." oninput="autoResize(this)"></textarea>
        </div>`;
    } else if (type === 'list') {
      bodyHTML = `<div class="flex-1 p-8 text-left space-y-4">
          <span class="inline-block text-[9px] font-black px-4 py-1 rounded-full bg-amber-100 text-amber-600 tracking-widest uppercase">Feature List</span>
          <input type="text" placeholder="Section Header" class="block-heading w-full bg-transparent border-none outline-none text-xl font-black text-gray-900 placeholder-gray-300">
          <div class="features-list space-y-3"></div>
          <button type="button" onclick="addFeature(this)" class=" bg-[#5D5899] text-white px-6 py-2.5 rounded-xl text-[10px] font-black flex items-center gap-2 cursor-pointer"><span>+</span> Add List Item</button>
        </div>`;
    } else if (type === 'image') {
      bodyHTML = `
        <div class="flex-1 p-8 text-left space-y-4">
          <span class="inline-block text-[9px] font-black px-4 py-1 rounded-full bg-blue-100 text-blue-600 tracking-widest uppercase">Image Gallery</span>
          <input type="text" placeholder="Gallery Title" class="block-heading w-full bg-transparent border-none outline-none text-xl font-black text-gray-900 placeholder-gray-300 mb-4">
          
          <div id="grid-${uid}" class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-4">
            </div>

          <div class="mt-4">
            <div class="relative size-32 bg-gray-50 rounded-3xl border-2 border-dashed border-gray-200 flex flex-col items-center justify-center cursor-pointer hover:border-blue-400 hover:bg-white transition-all group" 
                onclick="document.getElementById('${uid}').click()">
              <input type="file" 
                    id="${uid}" 
                    name="product[product_images_attributes][][images][]" 
                    multiple 
                    accept="image/*" 
                    class="hidden" 
                    onchange="handleMultipleImages(this, 'grid-${uid}')">
              
              <div  class="flex flex-col items-center gap-2 text-gray-400 group-hover:text-blue-500">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                <span class="text-[10px] font-black uppercase">Add Images</span>
              </div>
            </div>
          </div>
        </div>`;
    } else if (type === 'video') {
      bodyHTML = `<div class="flex-1 p-8 text-left space-y-3">
          <span class="inline-block text-[9px] font-black px-4 py-1 rounded-full bg-red-100 text-red-500 tracking-widest uppercase">Video</span>
          <input type="url" placeholder="https://youtube.com/..." class="flex-1 bg-transparent border-none outline-none text-sm font-semibold text-gray-700">
        </div>`;
    }

    div.innerHTML = controls + bodyHTML;
    container.appendChild(div);
  }

  // Click × on a blockFades out and deletes block
  function removeBlock(btn) {
    const block = btn.closest('.block-item');
    block.style.opacity = '0';
    setTimeout(() => block.remove(), 250);
  }

  // Click ↑ or ↓Moves block up or down
  function moveBlock(btn, dir) {
    const block = btn.closest('.block-item');
    const container = document.getElementById('blocks-container');
    const items = [...container.querySelectorAll('.block-item')];
    const idx = items.indexOf(block);
    const target = idx + dir;
    if (target >= 0 && target < items.length) {
      if (dir === -1) container.insertBefore(block, items[target]);
      else container.insertBefore(items[target], block);
    }
  }

  // Click "Add List Item"Adds new feature row
  function addFeature(btn) {
    const list = btn.previousElementSibling;
    const item = document.createElement('div');
    item.className = 'feature-item flex items-start gap-4 border-l-[4px] border-[#5D5899] pl-6 py-1 slide-in';
    item.innerHTML = `
      <div class="flex-1">
        <input type="text" placeholder="Feature Title" class="w-full bg-transparent border-none outline-none text-lg text-base font-black text-gray-900 block mb-1">
        <textarea placeholder="Description..." class="w-full bg-transparent border-none outline-none text-base font-semibold text-gray-400 min-h-[28px]" oninput="autoResize(this)"></textarea>
      </div>
      <button onclick="this.parentElement.remove()" class="cursor-pointer text-gray-300 hover:text-red-500 text-xl font-bold">×</button>`;
    list.appendChild(item);
  }

  function previewHeroImage(input) {
  const preview = document.getElementById('hero-preview');
  const placeholder = document.getElementById('hero-placeholder');
  
  if (input.files && input.files[0]) {
    const reader = new FileReader();
    
    reader.onload = function(e) {
      // 1. وضع الصورة في الـ Preview
      preview.src = e.target.result;
      
      // 2. إظهار الصورة وإخفاء العناصر التوضيحية
      preview.classList.remove('hidden');
      placeholder.classList.add('hidden');
    }
    
    reader.readAsDataURL(input.files[0]);
  }
}
// Typing in textareaMakes textarea grow/shrink
  function autoResize(el) {
    el.style.height = 'auto';
    el.style.height = el.scrollHeight + 'px';
  }

</script>