<div class="max-w-7xl mx-auto mt-8 px-4 py-8">

  <% if params[:subcategory].present? || params[:category].present? || params[:q].present?%>
    <%# ── FILTERED VIEW: flat grid with heading ── %>
    <div class="flex items-center justify-between border-b border-gray-100 pb-4 mb-8">
        <nav class="flex items-center space-x-3 text-[11px] font-black uppercase tracking-[0.15em] text-gray-400 mb-4">
          <a href="/" class="hover:text-[#5D5899] transition-all flex items-center group">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1.5 opacity-60 group-hover:opacity-100" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            Home
          </a>
          <span class="text-gray-600 font-light">/</span>
          <p class="text-[#5D5899] opacity-90 transition-all"><%= params[:subcategory] || params[:category] || params[:q] %></p>
        </nav>
        
      <%= link_to "← Back", root_path, class: "text-sm text-[#534AB7]" %>
    </div>

    <% if @products.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-5">
        <% @products.each do |product| %>
          <%= render "product_card", product: product, label:  product.category&.name %>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-24 text-gray-400">
        <p class="text-lg">No products found.</p>
        <%= link_to "Browse all", root_path, class: "mt-4 inline-block text-[#534AB7] text-sm font-medium" %>
      </div>
    <% end %>

  <% else %>
    <%# ── DEFAULT VIEW: segmented by category, same as home ── %>
    <% @nav_categories.each do |category| %>
      <% category_products = category.products.limit(4) %>
      <% next unless category_products.any? %>
      <div class="mb-12">
        <div class="flex items-center justify-between border-b border-gray-100 pb-4 mb-8">
          <h2 class="text-2xl font-semibold text-gray-900"><%= category.name %></h2>
          <%= link_to "See all", products_path(category: category.name),
              class: "text-sm font-medium text-[#534AB7] border border-[#534AB7] px-5 py-2 rounded-lg hover:bg-[#534AB7] hover:text-white transition-all duration-200" %>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-5">
          <% category_products.each do |product| %>
              <%= render "products/product_card", product: product, label: category.name %>          <% end %>
        </div>
      </div>
      
    <% end %>
  <% end %>

</div>