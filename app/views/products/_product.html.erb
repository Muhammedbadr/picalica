c  
    
   <%# ── Hero cover: images[0] has a single :image attached ── %>
  <% hero = product.images.first %>
  <% if hero&.image&.attached? %>
    <p><%= hero.title %></p>
    <%= image_tag hero.image, width: 100 %>
  <% end %>

  <%# ── Gallery pictures: images[1+] have :pictures attached ── %>
  <% product.images.drop(1).each do |gallery| %>
    <p><%= gallery.pictures.count %></p>
    <% gallery.pictures.each do |pic| %>
      <%= image_tag pic, width: 100 %>
    <% end %>
  <% end %>

  <% @product.texts.each do |text| %>
    <div class="text-block">
      <p><strong><%= text.title %></strong></p>
      <p><%= text.description %></p>
    </div>
  <%end%>

  <%# category %>
  <% if @product.subcategory %>
    <p><%= @product.subcategory.category.name %> → <%= @product.subcategory.name %></p>
  <% end %>


    <h3 class="text-xs font-bold text-gray-500 uppercase tracking-widest">Selected Tags</h3>
    <div class="flex flex-wrap gap-2 mt-2">
      <%# CRITICAL: Use @product.tags, NOT Tag.all %>
      <% if @product.tags.any? %>
        <% @product.tags.each do |tag| %>
          <span class="bg-indigo-600 text-white text-[10px] font-bold px-2 py-1 rounded uppercase">
            <%= tag.name %>
          </span>
        <% end %>
      <% else %>
        <span class="text-gray-400 text-sm">No tags selected for this product.</span>
      <% end %>
    </div>

  
  <div >
    <strong class="block font-medium mb-1">Title:</strong>
    <%= product.title %>
  </div>
  
  <% product.product_files.each do |product_file| %>
    <% if product_file.attachment.attached? %>
      <%= link_to "Download #{product_file.attachment.filename}", 
                  rails_blob_path(product_file.attachment, disposition: "attachment"), 
                  class: "text-blue-500 underline block" %>
      <p class="text-xs text-gray-500">
        Size: <%= number_to_human_size(product_file.attachment.byte_size) %>
      </p>
    <% end %>
  <% end %>
 
  <div>
    <strong class="block font-medium mb-1">exclusive_product:</strong>
    <%= product.exclusive_product %>
  </div>
  <div>
    <strong class="block font-medium mb-1">preview_url:</strong>
    <%= product.preview_url %>
  </div>
  
  <% @product.videos.each do |video| %>
    <p><%= video.title %></p>
    <p><%= link_to video.link, video.link, target: :_blank %></p>
  <% end %>
  
  <% @product.feature_sections.each do |section| %>
    <div class="feature-block mb-8">
      <h2 class="text-2xl font-bold text-[#5D5899] mb-4">
        <%= section.title %>
      </h2>

      <div class="items-list space-y-4">
        <% section.feature_items.each do |item| %>
          <div class="item pl-4 border-l-2 border-gray-200">
            <h4 class="font-bold"><%= item.item_title %></h4>
            <p class="text-gray-500"><%= item.description %></p>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
  <div>
    <strong class="block font-medium mb-1">Version:</strong>
    <%= product.issue_number %>
  </div>

  <%# <div>
    <strong class="block font-medium mb-1">Description:</strong>
    <%= product.description %>
  <%# </div> %>

  <%# IMPORTANT: Check if you added the price column yet! %>
  <% product.licenses.each do |license| %>
    <div class="text-sm">
      <span><%= license.title_name %></span> -
      <span class="font-bold">
        <%= number_to_currency(
          license.price,
          precision: 2,
          strip_insignificant_zeros: true
        ) %>
      </span>
    </div>
  <% end %>
  <%# Displaying the User's email instead of just a boring ID number %>
  <div>
    <strong class="block font-medium mb-1">Posted By:</strong>
    <%= product.user.name %> 
  </div>

  <%# Checking if it is an exclusive product %>
  <% if product.exclusive_product %>
    <span class="bg-yellow-100 text-yellow-800 text-xs font-semibold px-2.5 py-0.5 rounded">Exclusive</span>
  <% end %>

  <%# app/views/products/_product.html.erb %>
  <% if current_user && !current_user.owns_product?(@product) %>
    <%= form_with(url: cart_add_path, data: { turbo_frame: "_top" }) do |f| %>
      <%= f.hidden_field :id, value: @product.id %>
      <%= f.submit "Add to Cart" %>
    <% end %>
  <% end %>

