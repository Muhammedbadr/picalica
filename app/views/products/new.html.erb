<div class="px-4 " id="multi-step-form">
  
  <%# --- FORM CONTAINER --- %>
  <%= form_with(model: @product, local: true, validate: true , class: "max-w-5xl mx-auto space-y-10 ") do |f| %>
    
    <%# PART 1:  %>
    <div class="form-section  md:p-12 space-y-8" id="section-1">
      
        <% if @product.errors.any? %>
          <div class="mb-6 p-4 bg-red-50 border-l-4 border-red-500 rounded-r-xl">
            <ul class="text-xs font-black text-red-700 uppercase tracking-widest list-none">
              <% @product.errors.full_messages.each do |msg| %>
                <li>⚠️ <%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="max-w-5xl mx-auto mb-10 px-4">
          <%# --- BREADCRUMBS --- %>
          <nav class="flex items-center space-x-3 text-[11px] font-black uppercase tracking-[0.15em] text-gray-400 mb-4">
            <a href="/" class="hover:text-[#5D5899] transition-all flex items-center group">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1.5 opacity-60 group-hover:opacity-100" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
              Home
            </a>
            <span class="text-gray-600 font-light">/</span>
            <span class="text-[#5D5899] opacity-90">Create New</span>
          </nav>

          <div class="space-y-1">
              <h1 class="text-3xl font-black text-gray-900 tracking-tight">
                Create New Product
              </h1>
              <div class="flex items-center text-sm font-semibold text-gray-500">
                <span class="inline-block w-2 h-2 rounded-full bg-[#5D5899] mr-2"></span>
                Step 1: Core Identity & Basic Details
              </div>
          </div>
        </div>

        <%# SECTION 1: CORE IDENTITY %>
        <div class="bg-white rounded-[2rem] p-10 mt-6 border border-gray-100 shadow-sm space-y-8 ">
          <div class="flex items-center space-x-4 border-b border-gray-50 pb-6">
            <div class="w-10 h-10 rounded-xl bg-[#5D5899]/10 flex items-center justify-center text-[#5D5899]">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-black text-gray-900 tracking-tight">General Information</h3>
              <p class="text-xs text-gray-400 font-bold uppercase tracking-widest mt-1">Basic product identification</p>
            </div>
          </div>
          
          <div class="space-y-6">
            <%# title %>
            <div class="space-y-2">
              <%= f.label :title, "Product Title", class: "text-[11px] font-black text-gray-500 uppercase tracking-widest ml-1" %>
              <%= f.text_field :title, placeholder: "e.g. Premium Shopify Dashboard", class: "w-full px-6 py-4 rounded-2xl border border-gray-100 bg-gray-100/50 focus:bg-white focus:ring-4 focus:ring-[#5D5899]/5 focus:border-[#5D5899] outline-none transition-all font-medium text-gray-900 shadow-inner" %>
            </div>


            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              <%# categories %>
              <div class="space-y-2">
                <%= f.label :subcategory_id, "categories", class: "text-[11px] font-black text-gray-500 uppercase" %>
                
                <%= f.grouped_collection_select :subcategory_id, 
                                                @categories, # Uses the variable from your controller
                                                :subcategories, 
                                                :name, 
                                                :id, 
                                                :name, 
                                                { include_blank: "Select a Category" }, 
                                                { class: "w-full px-6 py-4 rounded-2xl border border-gray-100 bg-gray-100/50 focus:bg-white focus:ring-4 focus:ring-[#5D5899]/5 outline-none font-bold text-gray-700" } %>
              </div>
              
              <%# preview_url %>
              <div class="space-y-2">
                <%= f.label :preview_url, "Live Demonstration Link", class: "text-[11px] font-black text-gray-500 uppercase tracking-widest ml-1" %>
                <%= f.text_field :preview_url, placeholder: "https://example.com/demo", class: "w-full px-6 py-4 rounded-2xl border border-gray-100 bg-gray-100/50 focus:bg-white focus:ring-4 focus:ring-[#5D5899]/5 outline-none transition-all font-medium shadow-inner" %>
              </div>
            </div>
            
            <%# tag %>
            <div class="space-y-2" data-controller="multi-select">
              <%# 1. Label with Tooltip Icon %>
              <div class="flex items-center space-x-2 ml-1">
                <%= f.label :tag_ids, "Search Tags", class: "text-[11px] font-black text-gray-500 uppercase tracking-wider" %>
                
                <div class="group relative cursor-help">
                  <svg class="w-3.5 h-3.5 text-gray-400 hover:text-gray-600" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8c0 1.657-1.343 3-3 3a1 1 0 100 2 3 3 0 01-3-3 1 1 0 011-1h.01a1 1 0 100-2H10z" clip-rule="evenodd" />
                  </svg>
                  <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:block w-48 p-2 bg-gray-900 text-white text-[10px] rounded shadow-xl z-50 leading-tight">
                    Tags are keywords that help customers find your product more easily.
                  </div>
                </div>
              </div>

              <%# 2. The Input Wrapper %>
              <div class="relative w-full mt-2">

                <%# Hidden multi-select %>
                <%= f.collection_select :tag_ids, Tag.all, :id, :name, {},
                    { multiple: true, class: "hidden", data: { multi_select_target: "hiddenSelect" } } %>

                <%# Pill input box %>
                <div class="flex flex-wrap items-center gap-2 min-h-[52px] px-4 py-2.5
                            bg-gray-100/60 border border-gray-200 rounded-2xl
                            focus-within:bg-white focus-within:border-[#7F77DD]
                            focus-within:ring-4 focus-within:ring-[#5D5899]/10
                            transition-all cursor-text"
                    id="selected-tags">

                  <div data-multi-select-target="pills" class="flex flex-wrap gap-2"></div>

                  <input type="text"
                        data-multi-select-target="input"
                        data-action="input->multi-select#filter focus->multi-select#showDropdown blur->multi-select#hideDropdown"
                        id="search"
                        class="flex-1 min-w-[120px] outline-none bg-transparent text-sm text-gray-800 placeholder:text-gray-400 py-1"
                        placeholder="Search tags…">
                </div>

                <%# Dropdown %>
                <ul class="absolute z-50 w-full bg-white border border-gray-200 rounded-2xl
                          shadow-xl shadow-black/5 mt-1.5 overflow-hidden max-h-60 overflow-y-auto hidden
                          divide-y divide-gray-50"
                    data-multi-select-target="dropdown">

                  <li class="px-4 py-2 pointer-events-none">
                    <span class="text-[10px] font-bold uppercase tracking-widest text-gray-400">Suggestions</span>
                  </li>

                  <% Tag.all.each do |tag| %>
                    <li class="flex items-center gap-3 px-4 py-2.5 text-sm text-gray-700 cursor-pointer hover:bg-gray-50 transition-colors"
                        data-action="mousedown->multi-select#select"
                        data-tag-id="<%= tag.id %>"
                        data-tag-name="<%= tag.name %>">
                      <svg class="w-3.5 h-3.5 text-gray-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h11a2 2 0 012 2v11l-7 7L3 13V5a2 2 0 012-2h2z"/>
                      </svg>
                      <%= tag.name %>
                    </li>
                  <% end %>
                </ul>
              </div>
            </div>
            
          </div>

          <%# SECTION 2: TECHNICAL SPECIFICATIONS & RELEASES %>
          <div class="flex items-center space-x-4 border-b border-gray-50 pb-6 pt-8">
            <div class="w-10 h-10 rounded-xl bg-[#5D5899]/10 flex items-center justify-center text-[#5D5899]">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-black text-gray-900 tracking-tight">Technical & Release Details</h3>
              <p class="text-xs text-gray-400 font-bold uppercase tracking-widest mt-1">Platform and version control</p>
            </div>
          </div>

          <div class="space-y-8">
            <%# Versioning Section %>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 ">
              <div class="space-y-2 ">
                <%= f.label :issue_number, "Version", class: "text-[11px] font-black text-gray-500 uppercase tracking-widest ml-1" %>
                <%= f.text_field :issue_number, placeholder: "e.g. 1.0.0", class: "w-full px-6 py-4 rounded-2xl border border-gray-100 bg-gray-100/50 outline-none font-black text-gray-900 shadow-inner" %>
              </div>
              
              <%# Pricing Toggle %>
              <div class="w-full  ">
                  <span class="text-[11px] font-black text-gray-400 uppercase tracking-widest">Product Type</span>
                  <div class="p-1.5 bg-gray-100 rounded-2xl flex items-center shadow-inner">
                    <label class="flex-1 text-center py-3 rounded-xl cursor-pointer transition-all has-[:checked]:bg-white has-[:checked]:text-[#5D5899] has-[:checked]:shadow-md text-gray-400 font-black text-[10px] uppercase tracking-tighter">
                      <%= f.radio_button :exclusive_product, true, class: "hidden" %> Exclusive
                    </label>
                    <label class="flex-1 text-center py-3 rounded-xl cursor-pointer transition-all has-[:checked]:bg-white has-[:checked]:text-[#5D5899] has-[:checked]:shadow-md text-gray-400 font-black text-[10px] uppercase tracking-tighter">
                      <%= f.radio_button :exclusive_product, false, class: "hidden", checked: true %> Standard
                    </label>
                  </div>
              </div>
            </div>

            <div class="space-y-2">
              <%= f.label :description, "Brief about Release", class: "text-[11px] font-black text-gray-500 uppercase tracking-widest ml-1" %>
              <%= f.text_area :description, rows: 3, placeholder: "What's new in this version?", class: "w-full px-6 py-4 rounded-2xl border border-gray-100 bg-gray-100/50 focus:bg-white focus:ring-4 focus:ring-[#5D5899]/5 focus:border-[#5D5899] outline-none transition-all font-medium text-gray-900 shadow-inner resize-none" %>
            </div>
          </div>

          <%# SECTION 3: PRICING & FINAL ASSETS %>
          <div class="flex items-center space-x-4 border-b border-gray-50 pb-4 pt-8">
            <div class="w-10 h-10 rounded-xl bg-[#5D5899]/10 flex items-center justify-center text-[#5D5899]">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-black text-gray-900 tracking-tight">Investment & Final Push</h3>
              <p class="text-xs text-gray-400 font-bold uppercase tracking-widest mt-1">Pricing, assets, and legal</p>
            </div>
          </div>
          
          <div data-controller="nested-form"  class="space-y-8 pt-2">
              <div class="flex flex-row  md:flex-row  items-start">
                <div class="w-full">
                  <!-- TEMPLATE -->
                  <template data-nested-form-target="template">
                    <%= f.fields_for :licenses, License.new, child_index: "NEW_RECORD" do |lic| %>
                      <%= render "licenses/license_fields", f: lic , show_remove: true %>
                    <% end %>
                  </template>

                  <!-- EXISTING -->
                    <%= f.fields_for :licenses do |lic|  %>
                      <%= render "licenses/license_fields", f: lic , show_remove: (lic.index > 0) %>
                    <% end %>
                  
                  <!-- TARGET -->
                  <div data-nested-form-target="target"></div>
                </div>
              </div>
              <!-- BUTTON -->
              <button type="button"
                      data-action="nested-form#add"
                      class="bg-[#5D5899] text-white py-3 px-4 rounded-2xl font-bold cursor-pointer hover:bg-[#4d4885] transition-all shadow-md">
                Add License +
              </button>
          </div>

          <%# Asset Dropzone ) %>
          <div class="space-y-4 mt-4">
            <span class="text-[11px] font-black text-gray-400 uppercase tracking-widest ml-1">Master Files</span>
            <%= render "productFile/file_form", f: f %>
          </div>

          <%# LEGAL AGREEMENTS  %>
        <div class="bg-indigo-50/50 rounded-[2rem] p-8 space-y-4 border border-indigo-100/50">
            <label class="flex items-start space-x-4 cursor-pointer group">
              <%= f.check_box :terms_agreement, class: "mt-1 w-6 h-6 rounded-lg text-[#5D5899] border-indigo-200 focus:ring-[#5D5899]" %>
              <span class="text-sm font-bold text-gray-600 group-hover:text-gray-900 transition-colors leading-relaxed">
                I agree to the <span class="text-[#5D5899] underline">Picalica Terms of Service</span> and Marketplace Guidelines.
              </span>
            </label>
            <label class="flex items-start space-x-4 cursor-pointer group">
              <%= f.check_box :ownership_confirmation, class: "mt-1 w-6 h-6 rounded-lg text-[#5D5899] border-indigo-200 focus:ring-[#5D5899]" %>
              <span class="text-sm font-bold text-gray-600 group-hover:text-gray-900 transition-colors leading-relaxed">
                I confirm that this product was created entirely by me and I hold full distribution rights.
              </span>
            </label>
        </div>

          <%# Action Bar %>
          
        <div class="flex justify-between flex-col sm:flex-row items-center gap-6 pt-6"> 

            <%= link_to "Discard Draft", products_path, 
                class: "text-[11px] font-black text-gray-400 hover:text-rose-500 uppercase tracking-[0.2em] transition-colors px-6" %>
            <%= f.submit "Submit",
              class: "w-auto px-4 py-4 bg-[#5D5899] hover:bg-[#4d4885] text-white font-black rounded-2xl shadow-xs shadow-indigo-200 transform hover:-translate-y-1 active:scale-95 transition-all uppercase tracking-[0.2em] text-sm cursor-pointer"
            %>          
        </div>

        </div>
    </div>

    
  <% end %>
</div>


<script>
  document.addEventListener("DOMContentLoaded", () => {
    // Checkbox styling
    document.querySelectorAll("[data-checkbox]").forEach((item) => {
      const checkbox = item.querySelector(".release-checkbox");
      const updateStyle = () => {
        if (checkbox.checked) {
          item.classList.add("bg-indigo-50");
          item.classList.remove("bg-white");
        } else {
          item.classList.add("bg-white");
          item.classList.remove("bg-indigo-50");
        }
      };
      updateStyle();
      checkbox.addEventListener("change", updateStyle);
    });

    // Hero image preview
    const heroInput = document.getElementById('hero-input');
    if (heroInput) {
      heroInput.addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = ev => {
          const img = document.getElementById('hero-preview');
          img.src = ev.target.result;
          img.classList.remove('hidden');
          document.getElementById('hero-placeholder').classList.add('hidden');
        };
        reader.readAsDataURL(file);
      });
    }
  });
   // Hero image preview
 

  function toggleCategoryDropdown() {
    document.getElementById('category-dropdown').classList.toggle('hidden');
    document.getElementById('category-chevron').classList.toggle('rotate-180');
  }
  function selectCategory(val, el) {
    document.getElementById('category-value').value = val;
    document.getElementById('category-label').textContent = val;
    document.getElementById('category-label').classList.replace('text-gray-400', 'text-gray-700');
    document.querySelectorAll('.category-option').forEach(i => i.classList.remove('bg-indigo-50', 'text-indigo-700', 'font-semibold'));
    el.classList.add('bg-indigo-50', 'text-indigo-700', 'font-semibold');
    document.getElementById('category-dropdown').classList.add('hidden');
    document.getElementById('category-chevron').classList.remove('rotate-180');
  }

  // dropdown
  document.addEventListener('DOMContentLoaded', () => {
    // Multi-select functionality
    const wrapper = document.querySelector('[data-controller="multi-select"]');
    if (wrapper) {
      const input = wrapper.querySelector('[data-multi-select-target="input"]');
      const dropdown = wrapper.querySelector('[data-multi-select-target="dropdown"]');
      const pills = wrapper.querySelector('[data-multi-select-target="pills"]');
      const hiddenSelect = wrapper.querySelector('[data-multi-select-target="hiddenSelect"]');

      // Show dropdown on focus
      if (input) {
        input.addEventListener('focus', () => {
          dropdown.classList.remove('hidden');
        });

        input.addEventListener('blur', () => {
          setTimeout(() => {
            dropdown.classList.add('hidden');
          }, 100);
        });

        // Filter tags on input
        input.addEventListener('input', (e) => {
          const value = e.target.value.toLowerCase();
          dropdown.querySelectorAll('li').forEach(li => {
            const tagName = li.textContent.toLowerCase();
            li.style.display = tagName.includes(value) ? '' : 'none';
          });
        });
      }

      // Select tag on click
      dropdown.querySelectorAll('li').forEach(li => {
        li.addEventListener('mousedown', (e) => {
          e.preventDefault();
          const tagId = li.dataset.tagId;
          const tagName = li.dataset.tagName;

          // Check if already selected
          if (pills.querySelector(`[data-tag-id="${tagId}"]`)) return;

          // Add to hidden select
          const option = document.createElement('option');
          option.value = tagId;
          option.textContent = tagName;
          option.selected = true;
          hiddenSelect.appendChild(option);

          // Add pill
          const pill = document.createElement('span');
          pill.className = 'bg-indigo-500 text-white px-3 py-1 rounded-full text-sm flex items-center gap-2';
          pill.dataset.tagId = tagId;
          pill.innerHTML = `${tagName} <button type="button" class="ml-1 text-xs font-bold">&times;</button>`;

          pill.querySelector('button').addEventListener('click', (e) => {
            e.preventDefault();
            pill.remove();
            hiddenSelect.querySelector(`option[value="${tagId}"]`).remove();
          });

          pills.appendChild(pill);
          input.value = '';
          dropdown.classList.remove('hidden');
          input.focus();
        });
      });
    }
  });

</script>

<style>
  /* Styling the 'Pills' inside the input (for Tom Select/Select2) */
  .ts-control .item {
    background-color: #5D5899 !important;
    color: white !important;
    border-radius: 6px !important;
    padding: 2px 8px !important;
    font-weight: 700 !important;
    font-size: 13px !important;
    display: flex !important;
    align-items: center !important;
  }

  /* Styling the 'X' remove button on the pill */
  .ts-control .item .remove {
    border-left: 1px solid rgba(255,255,255,0.2) !important;
    margin-left: 8px !important;
  }

  /* Styling the Dropdown List (Matches image_f94ac7.png) */
  .ts-dropdown .active {
    background-color: #5D5899 !important;
    color: white !important;
  }

  .ts-dropdown .option {
    padding: 10px 20px !important;
    font-weight: 500;
    color: #4B5563;
  }

  /* Multi-select dropdown styles */
  [data-multi-select-target="dropdown"] {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 50;
    background: white;
    border: 1px solid #e5e7eb;
    border-top: none;
    border-radius: 0 0 0.5rem 0.5rem;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    max-height: 15rem;
    overflow-y: auto;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  [data-multi-select-target="dropdown"].hidden {
    display: none;
  }

  [data-multi-select-target="dropdown"] li {
    padding: 0.5rem;
    cursor: pointer;
    font-size: 0.875rem;
    transition: background-color 0.15s;
  }

  [data-multi-select-target="dropdown"] li:hover {
    background-color: #e0e7ff;
  }
</style>
      