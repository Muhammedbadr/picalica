<div class="nested-fields bg-white rounded-3xl p-8 border border-gray-100 shadow-sm relative group">
  <%# Side Controls (Screenshot 7 & 8) %>
  <div class="absolute -right-4 top-1/2 -translate-y-1/2 flex flex-col gap-2">
    <button type="button" class="w-8 h-8 bg-white shadow-md rounded-lg flex items-center justify-center text-gray-400">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="3" d="M5 15l7-7 7 7"/></svg>
    </button>
    <button type="button" class="w-8 h-8 bg-white shadow-md rounded-lg flex items-center justify-center text-gray-400">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="3" d="M19 9l-7 7-7-7"/></svg>
    </button>
    <button type="button" data-action="nested-form#remove" class="w-8 h-8 bg-white shadow-md rounded-lg flex items-center justify-center text-rose-400">
      <span class="text-lg">×</span>
    </button>
  </div>

  <div class="text-right">
    <h4 class="text-lg font-black text-gray-800 mb-6">المميزات</h4>
    
    <%# Inner Nested Form for the actual list items %>
    <div data-controller="nested-form" data-nested-form-wrapper-selector-value=".item-fields">
      <div data-nested-form-target="target">
        <%# Item Template (Screenshot 4) %>
        <div class="item-fields mb-4 border-r-4 border-[#5D5899] pr-4 py-2 relative">
           <input type="text" placeholder="عنوان العنصر" class="w-full text-right font-bold text-gray-700 focus:outline-none mb-1">
           <textarea placeholder="اكتب وصف لهذا العنصر" class="w-full text-right text-xs text-gray-400 focus:outline-none resize-none"></textarea>
           <button type="button" data-action="nested-form#remove" class="absolute left-0 top-1/2 -translate-y-1/2 text-gray-400">×</button>
        </div>
      </div>

      <button type="button" data-action="nested-form#add" class="mt-4 bg-[#5D5899] text-white px-6 py-2 rounded-lg text-[10px] font-black flex items-center gap-2 mr-auto">
        <span>+</span> أضف عنصر قائمة
      </button>

      <template data-nested-form-target="template">
        <%# Same structure as .item-fields above %>
      </template>
    </div>
  </div>
</div>