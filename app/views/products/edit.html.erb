<%# app/views/products/edit.html.erb %>
<% content_for :title, "Editing Product - Step #{@step}" %>
  
    <% if @step == "1" %>
      <%# This renders your new.html.erb code %>
      <%= render template: "products/new" %>
    <% else %>
      <%# This renders your step_two.html.erb code %>
      <%= render template: "products/step_two" %>
    <% end %>

  <div class="mt-8 flex gap-4">
    <%= link_to "Cancel", products_path, class: "text-gray-400 font-bold uppercase text-xs" %>
  </div>











