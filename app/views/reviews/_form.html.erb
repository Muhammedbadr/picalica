<% { work_quality: "Work Quality", communication: "Communication", ease_of_use: "Ease of Use", documentation_quality: "Documentation" }.each do |attr, label| %>
  <div class="flex items-center justify-between py-2 border-b">
    <label class="text-sm font-bold text-gray-700"><%= label %></label>
    
    <div class="flex flex-row-reverse gap-1" data-controller="star-rating">
      <% (5).downto(1).each do |i| %>
        <%# Ensure the name is explicitly set so Rails knows it belongs to the 'review' model %>
        <%= f.radio_button attr, i, id: "#{attr}_#{i}", name: "review[#{attr}]", class: "hidden" %>
        
        <%= f.label "#{attr}_#{i}", 
            data: { 
              star_rating_target: "star", 
              action: "click->star-rating#highlight", 
              value: i, 
              group: attr 
            }, 
            class: "cursor-pointer text-gray-300 transition-colors" do %>
          <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>

<div class="mt-6">
  <%= f.label :content, "Your Review", class: "block text-sm font-bold text-gray-700 mb-2" %>
  <%= f.text_area :content, rows: 6, placeholder: "Tell us what you liked and how this product worked for you.", class: "w-full rounded-3xl border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-900 focus:border-[#5D5899] focus:bg-white focus:ring-2 focus:ring-[#5D5899]/20 outline-none transition-all" %>
</div>