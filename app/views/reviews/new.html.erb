<div class="max-w-xl mx-auto py-12 px-4">
  <h1 class="text-2xl font-black text-gray-900 mb-6">Write a Review</h1>
  
  <div class="bg-white p-8 rounded-3xl border border-gray-200 shadow-sm">
    <%= form_with(model: [@product, @review], local: true, class: "space-y-6") do |f| %>
      <%= render 'form', f: f %>

      <div class="pt-4">
        <%= f.submit "Submit Review",
            class: "w-full py-3 px-4 bg-[#5D5899] hover:bg-[#4d4885] text-white font-black rounded-2xl shadow-md transition-all duration-200 uppercase tracking-widest text-sm" %>
      </div>
    <% end %>
  </div>
</div>