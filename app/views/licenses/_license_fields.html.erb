<div class="nested-form-wrapper group relative p-5 mb-4 border border-gray-100 bg-white md:bg-transparent md:border-none md:p-0 rounded-3xl transition-all hover:border-gray-200">
  
  <%= f.hidden_field :_destroy %>

  <%# Grid System %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6">

    <%# Price Field %>
    <div class="space-y-2">
      <%= f.label :price, "Price (USD)", class: "text-[10px] md:text-[11px] font-bold text-gray-400 uppercase tracking-widest ml-1" %>
      <div class="relative group/input">
        <span class="absolute left-5 top-1/2 -translate-y-1/2 text-gray-400 font-medium text-lg md:text-xl transition-colors group-focus-within/input:text-[#5D5899]">$</span>
        <%= f.number_field :price, placeholder: "0.00", step: :any,
            class: "w-full pl-11 pr-5 py-3.5 rounded-2xl border border-gray-200/80 bg-gray-50/50 text-gray-800 font-semibold text-lg md:text-xl outline-none focus:bg-white focus:border-[#5D5899] focus:ring-4 focus:ring-[#5D5899]/10 transition-all placeholder:text-gray-300" %>
      </div>
    </div>

    <%# Custom License Type Dropdown %>
    <div class="space-y-2 custom-dropdown-container">
      <%= f.label :title_name, "License Type", class: "text-[10px] md:text-[11px] font-bold text-gray-400 uppercase tracking-widest ml-1" %>
      
      <div class="flex items-center gap-3">
        
        <%# Custom Dropdown Engine Wrapper %>
        <div class="relative flex-1">
          
          <%# 1. This hidden field stores the actual value sent to Rails %>
          <%= f.hidden_field :title_name, value: f.object.title_name || "Personal Use", class: "dropdown-hidden-input" %>
          
          <%# 2. Trigger Button (Acts like the select field look-alike) %>
          <button type="button" 
                  onclick="toggleCustomDropdown(this)"
                  class="dropdown-trigger-btn w-full flex items-center justify-between pl-5 pr-5 py-4 rounded-2xl border border-gray-200/80 bg-gray-50/50 text-gray-800 font-semibold text-sm md:text-base outline-none hover:bg-gray-100/50 focus:bg-white focus:border-[#5D5899] focus:ring-4 focus:ring-[#5D5899]/10 transition-all cursor-pointer">
            
            <span class="dropdown-display-text"><%= f.object.title_name || "Personal Use" %></span>
            
            <svg xmlns="http://www.w3.org/2000/svg" class="dropdown-chevron h-4 w-4 stroke-[2.5] text-gray-400 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </button>

          <%# 3. Custom Dropdown Floating Menu Options %>
          <div class="dropdown-menu hidden absolute left-0 right-0 top-[calc(100%+8px)] z-50 bg-white border border-gray-100 rounded-2xl shadow-xl p-1.5 space-y-0.5 transform scale-95 opacity-0 transition-all duration-150 origin-top">
            <button type="button" 
                    onclick="selectDropdownOption(this, 'Personal Use')"
                    class="w-full text-left px-4 py-3 text-sm font-medium rounded-xl text-gray-700 hover:bg-[#5D5899]/5 hover:text-[#5D5899] transition-colors cursor-pointer flex items-center justify-between">
              Personal Use
            </button>
            <button type="button" 
                    onclick="selectDropdownOption(this, 'Commercial License')"
                    class="w-full text-left px-4 py-3 text-sm font-medium rounded-xl text-gray-700 hover:bg-[#5D5899]/5 hover:text-[#5D5899] transition-colors cursor-pointer flex items-center justify-between">
              Commercial License
            </button>
          </div>

        </div>

        <%# Remove Button %>
        <% unless local_assigns[:show_remove] == false %>
          <button type="button" 
                  data-action="nested-form#remove" 
                  class="cursor-pointer flex-shrink-0 bg-gray-50 text-gray-400 hover:text-red-500 hover:bg-red-50 p-4 rounded-2xl border border-transparent hover:border-red-100 transition-all duration-200"
                  title="Remove option">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 md:h-5 md:w-5 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
          </button>
        <% end %>

      </div>
    </div>

  </div>
</div>

<%# Inline Page Script Logic %>
<script>
  function toggleCustomDropdown(button) {
    const container = button.parentElement;
    const menu = container.querySelector('.dropdown-menu');
    const chevron = button.querySelector('.dropdown-chevron');
    const isHidden = menu.classList.contains('hidden');
    
    // Close any other open custom dropdowns on the page first
    document.querySelectorAll('.dropdown-menu').forEach(m => {
      if(m !== menu) {
        m.classList.add('hidden', 'scale-95', 'opacity-0');
        m.parentElement.querySelector('.dropdown-chevron')?.classList.remove('rotate-180');
      }
    });

    if (isHidden) {
      // Open Menu
      menu.classList.remove('hidden');
      setTimeout(() => {
        menu.classList.remove('scale-95', 'opacity-0');
        menu.classList.add('scale-100', 'opacity-100');
      }, 10);
      chevron.classList.add('rotate-180');
    } else {
      // Close Menu
      menu.classList.remove('scale-100', 'opacity-100');
      menu.classList.add('scale-95', 'opacity-0');
      chevron.classList.remove('rotate-180');
      setTimeout(() => menu.classList.add('hidden'), 150);
    }
  }

  function selectDropdownOption(optionButton, value) {
    const container = optionButton.closest('.relative');
    const hiddenInput = container.querySelector('.dropdown-hidden-input');
    const displayText = container.querySelector('.dropdown-display-text');
    const triggerBtn = container.querySelector('.dropdown-trigger-btn');
    
    // Update data state values
    hiddenInput.value = value;
    displayText.innerText = value;
    
    // Force trigger close sequence
    toggleCustomDropdown(triggerBtn);
  }

  // Global click-away handler to close the dropdown if user clicks outside of it
  document.addEventListener('click', function(e) {
    if (!e.target.closest('.custom-dropdown-container')) {
      document.querySelectorAll('.dropdown-menu').forEach(menu => {
        menu.classList.remove('scale-100', 'opacity-100');
        menu.classList.add('scale-95', 'opacity-0');
        menu.parentElement.querySelector('.dropdown-chevron')?.classList.remove('rotate-180');
        setTimeout(() => menu.classList.add('hidden'), 150);
      });
    }
  });
</script>