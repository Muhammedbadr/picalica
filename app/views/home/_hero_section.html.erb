<div class="absolute inset-0 z-0">
    <%# Using an abstract, dark technical background for a more "digital asset" feel %>
    <img src="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=1920&q=80" 
         class="w-full h-full object-cover scale-105 motion-safe:animate-[pulse_10s_linear_infinite]" 
         alt="Digital Marketplace Background">
    
    <%# Layer 1: The Dark Gradient Overlay (Bottom to Top) %>
    <div class="absolute inset-0 bg-gradient-to-t from-[#0A0910] via-black/40 to-black/60"></div>
    
    <%# Layer 2: Subtle Blue/Indigo Glow for "Modern" feel %>
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-indigo-600/20 blur-[120px] rounded-full -translate-y-1/2 translate-x-1/2"></div>
  </div>

  <%# 2. Content Container %>
  <div class="relative z-10 max-w-5xl mx-auto px-6 text-center">
    
    <%# Badge Detail %>
    <div class="inline-block mb-6 px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20">
      <span class="text-[10px] font-black uppercase tracking-[0.3em] text-indigo-300">New Items Added Weekly</span>
    </div>
      <%# Best ready-made digital products %>
    <h1 class="text-5xl md:text-7xl font-black text-white mb-6 tracking-tighter leading-tight drop-shadow-lg">
      Best <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-purple-300">Ready-Made</span> <br> digital products 
    </h1>

    <p class="text-lg md:text-xl text-gray-300 font-medium mb-8 max-w-2xl mx-auto leading-relaxed">
      Get various customizable designs, templates, documents, and applications.
    </p>

    <%# 3. Modernized "Pill" Search Bar %>
    <div class="max-w-2xl mx-auto">
      <%= search_form_for @q, url: products_path, method: :get do |f| %>
        <div class="flex items-center bg-white/95 backdrop-blur-sm rounded-[2rem] p-1 shadow-[0_20px_50px_rgba(0,0,0,0.4)] transition-all duration-300 focus-within:ring-[12px] focus-within:ring-indigo-500/10">

          <div class="pl-6 text-gray-400 hidden sm:block">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
          </div>

          <%= f.search_field :title_or_subcategory_name_or_subcategory_category_name_or_tags_name_cont,
            placeholder: "Search products, categories, subcategories...",
            class: "w-full border-none focus:outline-none focus:ring-0 text-left px-4 md:px-6 py-4 text-gray-800 text-lg font-bold placeholder-gray-400 bg-transparent" %>

          <button type="submit" class="bg-[#5D5899] hover:bg-[#4d4885] hover:-translate-y-0.5 active:translate-y-0 text-white px-10 py-4 rounded-[1.7rem] font-black text-sm uppercase tracking-widest transition-all shadow-lg hover:shadow-indigo-500/30">
            Search
          </button>
  
        </div>
      <% end %>
    </div>
  </div>