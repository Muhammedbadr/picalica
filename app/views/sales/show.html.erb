<div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 py-12 px-4 sm:px-8">
  <div class="max-w-5xl mx-auto">
    
    <%# Breadcrumb %>
    <nav class="flex items-center space-x-3 text-[11px] font-black uppercase tracking-[0.15em] text-gray-400 mb-8">
      <%= link_to "Sales", sales_path, class: "hover:text-[#5D5899] transition-all" %>
      <span class="text-gray-600 font-light">/</span>
      <span class="text-[#5D5899] opacity-90"><%= @product.title %></span>
    </nav>

    <%# Header %>
    <div class="flex items-start justify-between gap-4 mb-8">
      <div class="flex-1">
        <h1 class="text-4xl sm:text-5xl font-black text-gray-900 mb-4 tracking-tight">
          <%= @product.title %>
        </h1>
        <p class="text-lg text-gray-600 font-medium mb-6">
          <%= @product.description %>
        </p>
      </div>
      <%= link_to sales_path, class: "inline-flex items-center gap-2 px-4 py-2.5 bg-white hover:bg-gray-50 border border-gray-200 text-gray-700 font-semibold rounded-xl transition-all" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
        <span>Back</span>
      <% end %>
    </div>

    <%# Product Image %>
    <% if @product.images.first&.image&.attached? %>
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 mb-8 overflow-hidden">
        <%= image_tag @product.images.first.image, class: "w-full h-80 object-cover rounded-xl" %>
      </div>
    <% end %>

    <%# Sales Stats Card %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
      
      <%# Times Sold %>
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 sm:p-8">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-gray-500 uppercase tracking-widest mb-3">Times Sold</p>
            <p class="text-5xl font-black text-blue-600"><%= @sold_count %></p>
            <p class="text-xs text-gray-500 mt-2"><%= @sold_count == 1 ? "sale" : "sales" %></p>
          </div>
          <div class="w-20 h-20 bg-blue-100 rounded-2xl flex items-center justify-center">
            <svg class="w-10 h-10 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
            </svg>
          </div>
        </div>
      </div>

      <%# Total Revenue %>
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 sm:p-8">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-gray-500 uppercase tracking-widest mb-3">Total Revenue</p>
            <p class="text-5xl font-black text-emerald-600">$<%= sprintf("%.2f", @total_revenue) %></p>
            <p class="text-xs text-gray-500 mt-2">from all sales</p>
          </div>
          <div class="w-20 h-20 bg-emerald-100 rounded-2xl flex items-center justify-center">
            <svg class="w-10 h-10 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
        </div>
      </div>

    </div>

    <%# Sales History Table %>
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
      <div class="px-6 sm:px-8 py-6 sm:py-8 border-b border-gray-100">
        <h2 class="text-2xl font-black text-gray-900">Sales History</h2>
      </div>

      <% if @sales.any? %>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="bg-gray-50 border-b border-gray-100">
                <th class="px-6 sm:px-8 py-4 text-left text-xs font-bold text-gray-600 uppercase tracking-wider">Order ID</th>
                <th class="px-6 sm:px-8 py-4 text-left text-xs font-bold text-gray-600 uppercase tracking-wider">Buyer</th>
                <th class="px-6 sm:px-8 py-4 text-left text-xs font-bold text-gray-600 uppercase tracking-wider">Date Sold</th>
                <th class="px-6 sm:px-8 py-4 text-left text-xs font-bold text-gray-600 uppercase tracking-wider">Status</th>
                <th class="px-6 sm:px-8 py-4 text-right text-xs font-bold text-gray-600 uppercase tracking-wider">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% @sales.each do |sale| %>
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-6 sm:px-8 py-4">
                    <span class="font-bold text-gray-900">#<%= sale.order.id %></span>
                  </td>
                  <td class="px-6 sm:px-8 py-4">
                    <div>
                      <p class="font-semibold text-gray-900"><%= sale.order.user.name || "Anonymous" %></p>
                      <p class="text-xs text-gray-500"><%= sale.order.user.email %></p>
                    </div>
                  </td>
                  <td class="px-6 sm:px-8 py-4">
                    <p class="font-medium text-gray-900"><%= sale.order.created_at.strftime("%b %d, %Y") %></p>
                    <p class="text-xs text-gray-500"><%= sale.order.created_at.strftime("%l:%M %p") %></p>
                  </td>
                  <td class="px-6 sm:px-8 py-4">
                    <% if sale.order.status == "paid" %>
                      <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-emerald-50 border border-emerald-200 rounded-lg">
                        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                        <span class="font-semibold text-emerald-700 text-xs">Completed</span>
                      </div>
                    <% else %>
                      <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-gray-100 border border-gray-300 rounded-lg">
                        <span class="w-2 h-2 rounded-full bg-gray-500"></span>
                        <span class="font-semibold text-gray-700 text-xs"><%= sale.order.status.titleize %></span>
                      </div>
                    <% end %>
                  </td>
                  <td class="px-6 sm:px-8 py-4 text-right">
                    <%= link_to "View Order", order_path(sale.order), class: "inline-flex items-center gap-2 px-3 py-1.5 bg-blue-50 hover:bg-blue-100 text-blue-700 font-semibold rounded-lg transition-colors text-sm" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="px-6 sm:px-8 py-16 text-center">
          <p class="text-gray-600 mb-2">No sales history for this product yet</p>
        </div>
      <% end %>
    </div>

  </div>
</div>
