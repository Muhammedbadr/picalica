<div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 py-12 px-4 sm:px-8">
  <div class="max-w-6xl mx-auto">
    
    <%# Header %>
    <nav class="flex items-center space-x-3 text-[11px] font-black uppercase tracking-[0.15em] text-gray-400 mb-8">
      <a href="/" class="hover:text-[#5D5899] transition-all flex items-center group">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1.5 opacity-60 group-hover:opacity-100" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        Home
      </a>
      <span class="text-gray-600 font-light">/</span>
      <span class="text-[#5D5899] opacity-90">Sales</span>
    </nav>

    <div class="flex items-center gap-3 sm:gap-4 mb-6 sm:mb-8">
      <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-[#5D5899]/10 flex items-center justify-center text-[#5D5899]">
        <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z"/>
        </svg>
      </div>
      
      <div>
        <h1 class="text-xl sm:text-2xl font-black text-gray-900 tracking-tight">Purchases</h1>
        
      </div>
    </div>
    <%# Stats Cards %>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      
      <%# Total Products Sold %>
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 sm:p-8">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-gray-500 uppercase tracking-widest mb-2">Total Items Sold</p>
            <p class="text-4xl font-black text-gray-900"><%= @total_sold %></p>
          </div>
          <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center">
            <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
            </svg>
          </div>
        </div>
      </div>

      <%# Total Revenue %>
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 sm:p-8">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-gray-500 uppercase tracking-widest mb-2">Total Revenue</p>
            <p class="text-4xl font-black text-gray-900">$<%= sprintf("%.2f", @total_revenue) %></p>
          </div>
          <div class="w-16 h-16 bg-emerald-100 rounded-2xl flex items-center justify-center">
            <svg class="w-8 h-8 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
        </div>
      </div>

      <%# Products With Sales %>
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 sm:p-8">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-gray-500 uppercase tracking-widest mb-2">Products Sold</p>
            <p class="text-4xl font-black text-gray-900"><%= @sold_products.count %></p>
          </div>
          <div class="w-16 h-16 bg-purple-100 rounded-2xl flex items-center justify-center">
            <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 012 12V7a2 2 0 012-2z"/>
            </svg>
          </div>
        </div>
      </div>

    </div>

    <%# Sold Products Table %>
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
      <div class="px-6 sm:px-8 py-6 sm:py-8 border-b border-gray-100">
        <h2 class="text-2xl font-black text-gray-900">Your Sold Products</h2>
      </div>

      <% if @sold_products.any? %>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="bg-gray-50 border-b border-gray-100">
                <th class="px-6 sm:px-8 py-4 text-left text-xs font-bold text-gray-600 uppercase tracking-wider">Product Name</th>
                <th class="px-6 sm:px-8 py-4 text-left text-xs font-bold text-gray-600 uppercase tracking-wider">Times Sold</th>
                <th class="px-6 sm:px-8 py-4 text-left text-xs font-bold text-gray-600 uppercase tracking-wider">Revenue</th>
                <th class="px-6 sm:px-8 py-4 text-right text-xs font-bold text-gray-600 uppercase tracking-wider">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% @sold_products.each do |product| %>
                <% stats = @product_stats[product.id] %>
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-6 sm:px-8 py-4">
                    <div class="flex items-center gap-4">
                      <% if product.images.first&.image&.attached? %>
                        <%= image_tag product.images.first.image, class: "w-12 h-12 rounded-lg object-cover" %>
                      <% else %>
                        <div class="w-12 h-12 bg-gray-200 rounded-lg flex items-center justify-center">
                          <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                          </svg>
                        </div>
                      <% end %>
                      <div>
                        <h3 class="font-bold text-gray-900"><%= product.title %></h3>
                        <p class="text-xs text-gray-500">Created <%= product.created_at.strftime("%b %d, %Y") %></p>
                      </div>
                    </div>
                  </td>
                  <td class="px-6 sm:px-8 py-4">
                    <span class="text-lg font-bold text-gray-900"><%= stats[:sold_count] %></span>
                  </td>
                  <td class="px-6 sm:px-8 py-4">
                    <span class="text-lg font-bold text-emerald-600">$<%= sprintf("%.2f", stats[:total_revenue]) %></span>
                  </td>
                  <td class="px-6 sm:px-8 py-4 text-right">
                    <%= link_to "View Details", sale_path(product), class: "inline-flex items-center gap-2 px-4 py-2 bg-blue-50 hover:bg-blue-100 text-blue-700 font-semibold rounded-lg transition-colors" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="px-6 sm:px-8 py-16 text-center">
          <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m0 0l8 4m-8-4v10l8 4m0-10l8 4m-8-4v10l8 4M7 21h10"/>
          </svg>
          <h3 class="text-xl font-bold text-gray-600 mb-2">No Products Sold Yet</h3>
          <p class="text-gray-500 mb-6">Your sold products will appear here</p>
        </div>
      <% end %>
    </div>

  </div>
</div>
