<div class="min-h-screen w-full flex items-center justify-center py-12 bg-gray-50">
  <%# Main Container %>
  <div class="flex w-full min-h-screen sm:min-h-0 sm:max-w-4xl bg-white sm:rounded-3xl sm:shadow-2xl overflow-hidden border border-gray-100">
    
    <%# LEFT SIDE: Branding %>
    <div class="hidden lg:flex lg:w-1/2 bg-[#5D5899] p-12 flex-col justify-between text-white relative">
      <%# Subtle Background Texture %>
      <div class="absolute inset-0 opacity-10 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')]"></div>
      
      <div class="relative z-10">
        <div class="text-2xl font-black tracking-tighter">Picalica</div>
      </div>
      
      <div class="relative z-10">
        <h2 class="text-4xl font-extrabold mb-4 leading-tight">Manage Your <br>Settings.</h2>
        <p class="text-indigo-100 text-lg opacity-90">Keep your account secure and your professional info up to date.</p>
      </div>

      <div class="relative z-10 text-xs font-medium opacity-50 uppercase tracking-widest">
        Last activity: <%= Time.now.strftime("%B %d, %Y") %>
      </div>
    </div>

    <%# RIGHT SIDE: Edit Form %>
    <div class="w-full lg:w-1/2 px-8 py-10 sm:px-16 flex flex-col justify-center bg-white">
      
      <%# Mobile Logo (Visible only on small screens) %>
      <div class="lg:hidden flex justify-center mb-8">
        <div class="text-3xl font-black text-[#5D5899] tracking-tighter">Picalica</div>
      </div>

      <div class="mb-6 flex items-center justify-between">
        <h1 class="text-2xl font-extrabold text-gray-900">Edit Profile</h1>
        <%= link_to "Back", :back, class: "text-xs font-bold text-[#5D5899] hover:underline uppercase tracking-wider transition-all" %>
      </div>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-4" }) do |f| %>
        
        <%# Error Messages %>
        <% if resource.errors.any? %>
          <div class="p-4 mb-4 text-xs font-bold text-rose-600 bg-rose-50 rounded-xl border border-rose-100">
            <%= render "devise/shared/error_messages", resource: resource %>
          </div>
        <% end %>

        <%# Email Field %>
        <div class="space-y-1.5">
          <%= f.label :email, class: "text-xs font-bold text-gray-700 uppercase tracking-wider" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", 
              class: "w-full px-4 py-3 rounded-2xl border border-gray-200 bg-gray-50 text-gray-900 focus:bg-white focus:ring-2 focus:ring-[#5D5899] focus:border-transparent transition-all outline-none font-medium" %>
        </div>

        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <div class="p-3 bg-amber-50 border border-amber-100 rounded-xl text-[11px] text-amber-700">
            Waiting confirmation for: <b class="text-amber-900"><%= resource.unconfirmed_email %></b>
          </div>
        <% end %>

        <%# Password Section %>
        <div class="pt-4 border-t border-gray-100 mt-2 space-y-4">
          <p class="text-[10px] text-gray-400 font-bold uppercase tracking-widest">Security Update (Optional)</p>
          
          <div class="space-y-4">
            <div class="space-y-1.5">
              <%= f.label :password, "New Password", class: "text-xs font-bold text-gray-700 uppercase tracking-wider" %>
              <%= f.password_field :password, autocomplete: "new-password", placeholder: "Leave blank to keep current",
                  class: "w-full px-4 py-3 rounded-2xl border border-gray-200 bg-gray-50 text-gray-900 focus:bg-white focus:ring-2 focus:ring-[#5D5899] focus:border-transparent transition-all outline-none font-medium" %>
            </div>

            <div class="space-y-1.5">
              <%= f.label :password_confirmation, "Confirm New Password", class: "text-xs font-bold text-gray-700 uppercase tracking-wider" %>
              <%= f.password_field :password_confirmation, autocomplete: "new-password", 
                  class: "w-full px-4 py-3 rounded-2xl border border-gray-200 bg-gray-50 text-gray-900 focus:bg-white focus:ring-2 focus:ring-[#5D5899] focus:border-transparent transition-all outline-none font-medium" %>
            </div>
          </div>
        </div>

        <%# Current Password (Required) %>
        <div class="pt-6 border-t border-gray-100">
          <div class="space-y-2">
            <div class="flex justify-between">
              <%= f.label :current_password, class: "text-xs font-black text-gray-900 uppercase tracking-wider" %>
              <span class="text-[10px] text-rose-500 font-black tracking-widest">REQUIRED</span>
            </div>
            <%= f.password_field :current_password, autocomplete: "current-password", 
                placeholder: "Confirm changes with password",
                class: "w-full px-4 py-3.5 rounded-2xl border-2 border-indigo-50 bg-white text-gray-900 focus:ring-2 focus:ring-[#5D5899] focus:border-transparent transition-all outline-none shadow-sm font-medium" %>
          </div>
        </div>

        <div class="pt-4">
          <%= f.submit "Save Changes", 
              class: "w-full py-4 px-6 bg-[#5D5899] hover:bg-[#4d4885] text-white font-black rounded-2xl shadow-xl shadow-indigo-100 hover:shadow-indigo-200 transform hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-200 cursor-pointer uppercase tracking-widest text-sm" %>
        </div>
      <% end %>

      <%# Danger Zone %>
      <div class="mt-8 pt-6 border-t border-gray-100">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="text-xs font-bold text-gray-900 uppercase tracking-tight">Delete Account</h3>
            <p class="text-[10px] text-gray-400">This action is irreversible</p>
          </div>
          <%= button_to "Cancel Account", registration_path(resource_name), 
              data: { confirm: "Are you sure?", turbo_confirm: "Are you sure?" }, 
              method: :delete,
              class: "text-[10px] font-black text-rose-500 hover:text-white hover:bg-rose-500 py-2 px-3 border border-rose-100 rounded-xl transition-all uppercase tracking-widest" %>
        </div>
      </div>
    </div>

  </div>
</div>