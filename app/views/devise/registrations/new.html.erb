<div class="min-h-screen w-full flex items-center justify-center bg-gray-50">
  <%# Main Container %>
  <div class="flex w-full min-h-screen sm:min-h-0 sm:max-w-4xl bg-white sm:rounded-3xl sm:shadow-2xl overflow-hidden border border-gray-100">
    
    <%# LEFT SIDE: Registration Form %>
    <div class="w-full lg:w-1/2 px-8 py-10 sm:px-16 flex flex-col justify-center bg-white">
      
      <%# Mobile Logo (Visible only on small screens) %>
      <div class="lg:hidden flex justify-center mb-8">
        <div class="text-3xl font-black text-[#5D5899] tracking-tighter">Picalica</div>
      </div>

      <div class="mb-8 text-center lg:text-left">
        <h1 class="text-3xl font-extrabold text-gray-900 mb-2">Create Account</h1>
        <p class="text-gray-500 font-medium text-sm">Join us today! It only takes a minute.</p>
      </div>

      <%# Registration Form %>
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-5" }) do |f| %>
        
        <% if resource.errors.any? %>
          <div class="p-4 mb-4 text-xs font-bold text-rose-600 bg-rose-50 rounded-xl border border-rose-100">
            <%= render "devise/shared/error_messages", resource: resource %>
          </div>
        <% end %>

        <div class="space-y-1.5">
          <%= f.label :email, class: "text-xs font-bold text-gray-700 uppercase tracking-wider" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", 
              placeholder: "email@example.com",
              class: "w-full px-4 py-3.5 rounded-2xl border border-gray-200 bg-gray-50 text-gray-900 focus:bg-white focus:ring-2 focus:ring-[#5D5899] focus:border-transparent transition-all outline-none font-medium" %>
        </div>

        <div class="space-y-5">
          <div class="space-y-1.5">
            <div class="flex justify-between items-center">
              <%= f.label :password, class: "text-xs font-bold text-gray-700 uppercase tracking-wider" %>
              <% if @minimum_password_length %>
                <span class="text-[10px] text-gray-400 font-bold">MIN. <%= @minimum_password_length %> CHARS</span>
              <% end %>
            </div>
            <%= f.password_field :password, autocomplete: "new-password", 
                placeholder: "••••••••",
                class: "w-full px-4 py-3.5 rounded-2xl border border-gray-200 bg-gray-50 text-gray-900 focus:bg-white focus:ring-2 focus:ring-[#5D5899] focus:border-transparent transition-all outline-none" %>
          </div>

          <div class="space-y-1.5">
            <%= f.label :password_confirmation, "Confirm Password", class: "text-xs font-bold text-gray-700 uppercase tracking-wider" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", 
                placeholder: "••••••••",
                class: "w-full px-4 py-3.5 rounded-2xl border border-gray-200 bg-gray-50 text-gray-900 focus:bg-white focus:ring-2 focus:ring-[#5D5899] focus:border-transparent transition-all outline-none" %>
          </div>
        </div>

        <div class="pt-4">
          <%= f.submit "Create Account", 
              class: "w-full py-4 px-6 bg-[#5D5899] hover:bg-[#4d4885] text-white font-black rounded-2xl shadow-xl shadow-indigo-100 hover:shadow-indigo-200 transform hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-200 cursor-pointer uppercase tracking-widest text-sm" %>
        </div>
      <% end %>

      <div class="mt-10 text-center lg:text-left">
        <p class="text-gray-500 text-sm font-medium">
          Already have an account? 
          <%= link_to "Sign in here", new_session_path(resource_name), class: "font-black text-[#5D5899] hover:text-[#4d4885] ml-1" %>
        </p>
      </div>
    </div>

    <%# RIGHT SIDE: Visual/Branding (Hidden on mobile) %>
    <div class="hidden lg:flex lg:w-1/2 bg-[#5D5899] p-12 flex-col justify-between text-white relative">
      <%# Subtle Background Texture %>
      <div class="absolute inset-0 opacity-10 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')]"></div>
      
      <div class="relative z-10 text-right">
        <div class="text-2xl font-black tracking-tighter">Picalica</div>
      </div>
      
      <div class="relative z-10 text-right">
        <h2 class="text-4xl font-extrabold mb-4 leading-tight">Start Your <br>Creative Journey.</h2>
        <p class="text-indigo-100 text-lg opacity-90">Join a growing community of digital artisans and professionals.</p>
      </div>

      <div class="relative z-10 text-right text-xs font-medium opacity-50 uppercase tracking-widest">
        &copy; 2026 Picalica Marketplace
      </div>
    </div>
  </div>
</div>