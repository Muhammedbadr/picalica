<div class="min-h-screen w-full flex items-center justify-center bg-gray-50 py-12">
  <%# Main Container %>
  <div class="flex w-full min-h-screen sm:min-h-0 sm:max-w-4xl bg-white sm:rounded-3xl sm:shadow-2xl overflow-hidden border border-gray-100">
    
    <%# LEFT SIDE: Branding (Hidden on mobile) %>
    <div class="hidden lg:flex lg:w-1/2 bg-[#5D5899] p-12 flex-col justify-between text-white relative">
      <%# Texture Overlay %>
      <div class="absolute inset-0 opacity-10 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')]"></div>
      
      <div class="relative z-10">
        <div class="text-2xl font-black tracking-tighter">Picalica</div>
      </div>
      
      <div class="relative z-10">
        <h2 class="text-4xl font-extrabold mb-4 leading-tight">Securing Your <br>Creative Space.</h2>
        <p class="text-indigo-100 text-lg opacity-90 text-balance">Don't worry, even the best designers forget their keys sometimes.</p>
      </div>

      <div class="relative z-10 text-[10px] font-medium opacity-50 uppercase tracking-[0.2em]">
        Safe & Encrypted Reset
      </div>
    </div>

    <%# RIGHT SIDE: Reset Form %>
    <div class="w-full lg:w-1/2 px-8 py-12 sm:px-16 flex flex-col justify-center bg-white">
      
      <%# Mobile Logo (Visible only on small screens) %>
      <div class="lg:hidden flex justify-center mb-8">
        <div class="text-3xl font-black text-[#5D5899] tracking-tighter">Picalica</div>
      </div>

      <div class="mb-10 text-center lg:text-left">
        <h1 class="text-3xl font-extrabold text-gray-900 mb-2">Password Reset</h1>
        <p class="text-gray-500 font-medium text-sm leading-relaxed">Enter your email and we'll send you instructions to get back into your account.</p>
      </div>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-6" }) do |f| %>
        
        <%# Error Messages %>
        <% if resource.errors.any? %>
          <div class="p-4 mb-4 text-xs font-bold text-rose-600 bg-rose-50 rounded-xl border border-rose-100">
            <%= render "devise/shared/error_messages", resource: resource %>
          </div>
        <% end %>

        <div class="space-y-2">
          <%= f.label :email, class: "text-xs font-bold text-gray-700 uppercase tracking-wider" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", 
              placeholder: "your@email.com",
              class: "w-full px-4 py-4 rounded-2xl border border-gray-200 bg-gray-50 text-gray-900 focus:bg-white focus:ring-2 focus:ring-[#5D5899] focus:border-transparent transition-all outline-none font-medium" %>
        </div>

        <div class="pt-2">
          <%= f.submit "Send Reset Link", 
              class: "w-full py-4 px-6 bg-[#5D5899] hover:bg-[#4d4885] text-white font-black rounded-2xl shadow-xl shadow-indigo-100 hover:shadow-indigo-200 transform hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-200 cursor-pointer uppercase tracking-widest text-sm" %>
        </div>
      <% end %>

      <%# Navigation Links %>
      <div class="mt-12 text-center lg:text-left">
        <p class="text-gray-500 text-sm font-medium">
          Remembered it? 
          <%= link_to "Sign in here", new_session_path(resource_name), class: "font-black text-[#5D5899] hover:text-[#4d4885] ml-1 transition-colors" %>
        </p>
      </div>
    </div>

  </div>
</div>