<div class="min-h-screen w-full flex items-center justify-center bg-gray-50 py-12">
  <%# Main Container %>
  <div class="flex w-full min-h-screen sm:min-h-0 sm:max-w-4xl bg-white sm:rounded-3xl sm:shadow-2xl overflow-hidden border border-gray-100">
    
    <%# LEFT SIDE: Change Password Form %>
    <div class="w-full lg:w-1/2 px-8 py-12 sm:px-16 flex flex-col justify-center bg-white">
      
      <%# Mobile Logo %>
      <div class="lg:hidden flex justify-center mb-8">
        <div class="text-3xl font-black text-[#5D5899] tracking-tighter">Picalica</div>
      </div>

      <div class="mb-10 text-center lg:text-left">
        <h1 class="text-3xl font-extrabold text-gray-900 mb-2">Set New Password</h1>
        <p class="text-gray-500 font-medium text-sm">Almost there! Choose a strong password to secure your account.</p>
      </div>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-5" }) do |f| %>
        <%= f.hidden_field :reset_password_token %>
        
        <%# Error Messages %>
        <% if resource.errors.any? %>
          <div class="p-4 mb-4 text-xs font-bold text-rose-600 bg-rose-50 rounded-xl border border-rose-100">
            <%= render "devise/shared/error_messages", resource: resource %>
          </div>
        <% end %>

        <%# New Password %>
        <div class="space-y-1.5">
          <div class="flex justify-between items-center">
            <%= f.label :password, "New Password", class: "text-xs font-bold text-gray-700 uppercase tracking-wider" %>
            <% if @minimum_password_length %>
              <span class="text-[10px] text-gray-400 font-bold uppercase">Min. <%= @minimum_password_length %> chars</span>
            <% end %>
          </div>
          <%= f.password_field :password, autofocus: true, autocomplete: "new-password", 
              placeholder: "••••••••",
              class: "w-full px-4 py-3.5 rounded-2xl border border-gray-200 bg-gray-50 text-gray-900 focus:bg-white focus:ring-2 focus:ring-[#5D5899] focus:border-transparent transition-all outline-none font-medium" %>
        </div>

        <%# Confirm New Password %>
        <div class="space-y-1.5">
          <%= f.label :password_confirmation, "Confirm New Password", class: "text-xs font-bold text-gray-700 uppercase tracking-wider" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", 
              placeholder: "••••••••",
              class: "w-full px-4 py-3.5 rounded-2xl border border-gray-200 bg-gray-50 text-gray-900 focus:bg-white focus:ring-2 focus:ring-[#5D5899] focus:border-transparent transition-all outline-none font-medium" %>
        </div>

        <div class="pt-4">
          <%= f.submit "Update Password", 
              class: "w-full py-4 px-6 bg-[#5D5899] hover:bg-[#4d4885] text-white font-black rounded-2xl shadow-xl shadow-indigo-100 hover:shadow-indigo-200 transform hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-200 cursor-pointer uppercase tracking-widest text-sm" %>
        </div>
      <% end %>

      <%# Back to Login link %>
      <div class="mt-10 text-center">
        <%= link_to "Return to Sign In", new_session_path(resource_name), class: "text-xs font-bold text-gray-400 hover:text-[#5D5899] uppercase tracking-widest transition-colors" %>
      </div>
    </div>

    <%# RIGHT SIDE: Branding (Hidden on mobile) %>
    <div class="hidden lg:flex lg:w-1/2 bg-[#5D5899] p-12 flex-col justify-between text-white relative">
      <%# Texture Overlay %>
      <div class="absolute inset-0 opacity-10 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')]"></div>
      
      <div class="relative z-10 text-right">
        <div class="text-2xl font-black tracking-tighter">Picalica</div>
      </div>
      
      <div class="relative z-10 text-right">
        <h2 class="text-4xl font-extrabold mb-4 leading-tight">Your Privacy <br>is our Priority.</h2>
        <p class="text-indigo-100 text-lg opacity-90">Updating your password regularly is a great way to keep your store safe.</p>
      </div>

      <div class="relative z-10 text-right text-[10px] font-medium opacity-50 uppercase tracking-[0.2em]">
        Verified Connection
      </div>
    </div>

  </div>
</div>